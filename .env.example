# ─────────────────────────────────────────────────────────────────────────
# نمونه‌ی متغیرهای محیطی. یک کپی به اسم `.env` بساز و مقادیر واقعی رو بذار.
# فایل `.env` توی .gitignore هست و نباید commit بشه.
# ─────────────────────────────────────────────────────────────────────────

# دیتابیس Postgres
# اگه با docker-compose دیپلوی می‌کنی (فایل docker-compose.yml ریشه‌ی پروژه)،
# این سه‌تا رو پر کن — خودِ Compose از روی همینا DATABASE_URL رو می‌سازه و
# جای این خط پایین‌تر رو override می‌کنه، پس دستیِ خودِ DATABASE_URL مهم نیست.
#
# ⚠️ رمز رو فقط از حروف انگلیسی و عدد بساز (بدون /  @  :  #  ? یا فاصله) —
# این کاراکترها توی URLِ اتصال معنیِ خاص دارن (مثلاً / جداکننده‌ی مسیره) و
# باعث می‌شن Prisma با خطای "invalid port number"/"database string is
# invalid" fail کنه، چون کل ساختارِ URL به‌هم می‌ریزه.
POSTGRES_USER="routine"
POSTGRES_PASSWORD=""
POSTGRES_DB="routine"

# اگه بدون Docker (مستقیم npm run start) اجرا می‌کنی، این خط واقعاً استفاده
# می‌شه — آدرس/رمز/نامِ دیتابیسِ خودت رو دستی بذار.
DATABASE_URL="postgresql://user:pass@localhost:5432/routine"

# NextAuth — کلید امضای JWT نشست. حتماً یک رشته‌ی تصادفیِ قوی باشه.
# با `openssl rand -base64 32` بساز. اگه ست نشه، در production نشست‌ها امن نیستن.
NEXTAUTH_SECRET="<openssl rand -base64 32>"
NEXTAUTH_URL="https://your-domain.example"

# سوپریوزر/ادمین — بدون این دو، seed هیچ ادمینی نمی‌سازه (رفتار fail-safe).
# رمز رو قوی بذار؛ دیگه هیچ رمزِ پیش‌فرضی داخل سورس هاردکد نشده.
SUPERADMIN_USERNAME=""
SUPERADMIN_PASSWORD=""

# محدودیت نرخ (rate limit) پشتِ پروکسی:
# فقط وقتی "1" بذار که اپ پشتِ یک پروکسیِ مورداعتماد (Nginx/Cloudflare/Vercel)
# باشه که هدر X-Forwarded-For رو با IP واقعیِ کلاینت بازنویسی می‌کنه.
# اگه اپ مستقیم در معرض اینترنته، خالی/۰ بذار وگرنه محدودیت‌های IP دور زده می‌شن.
TRUST_PROXY_HEADERS="0"

# ورود با گوگل (اختیاری) — از Google Cloud Console
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# فراخوانیِ هوش‌مصنوعی (رودمپ، برنامه‌ی ورزشی هوشمند، جایگزینیِ حرکت، اسکنِ
# عکسِ غذا) — از گیت‌وی آروان‌کلود (GPT-4o-mini، API سازگار با OpenAI).
# ARVAN_AI_BASE_URL: از صفحه‌ی خودِ مدل توی پنل، بخشِ «دسترسی» → «آدرس AI gateway».
# ARVAN_AI_API_KEY: از پنلِ آروان‌کلود → «ماشین یوزر» (Machine User) →
#   «کلیدهای دسترسی» → یکی از ردیف‌های «API Key» رو باز کن و مقدارِ کاملِ
#   (نه ماسک‌شده) رو کپی کن.
# هر دو مثل رمز رفتار کن — هیچ‌وقت جایی به‌جز همین .env کامیت نشن.
ARVAN_AI_BASE_URL=""
ARVAN_AI_API_KEY=""

# پیامک OTP فراموشی رمز (ملی‌پیامک). اگه ست نشه، کد فقط توی لاگ سرور نوشته می‌شه.
MELIPAYAMAK_USERNAME=""
MELIPAYAMAK_PASSWORD=""
MELIPAYAMAK_FROM=""

# ─────────────────────────────────────────────────────────────────────────
# ایمیل OTP (ورود بدون رمز با کد ۶رقمی) — از طریق یک اکانتِ SMTP که خودت
# مالکشی (نه Resend/SendGrid). با هر providerِ استاندارد SMTP کار می‌کنه
# (Gmail، Zoho، سرورِ اختصاصیِ خودت، …) — به هیچ‌کدوم قفل نیست.
# اگه این‌ها ست نشن: توی production ارسال واقعاً شکست می‌خوره (به‌جای یک
# «موفقِ» دروغین)؛ توی dev به‌جاش از یک صندوقِ آزمایشیِ Ethereal استفاده
# می‌شه و فقط لینکِ پیش‌نمایش لاگ می‌شه (نه خودِ کد — نگاه کن به
# lib/email/smtpProvider.ts).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
# آدرسِ فرستنده — می‌تونه فقط ایمیل باشه یا با نام: "Arion <no-reply@yourdomain.com>"
SMTP_FROM=""
# "1" برای TLSِ implicit (پورت ۴۶۵)؛ خالی/false برای STARTTLS روی پورت ۵۸۷ (پیش‌فرض)
SMTP_SECURE="0"

# انتخابِ Providerِ سرویسِ ایمیل — فعلاً فقط "smtp" پیاده شده؛ ساختار طوری‌ه
# که بعداً بشه "resend"/"ses"/"brevo" رو بدون تغییر بقیه‌ی سیستم اضافه کرد
# (نگاه کن به lib/email/index.ts).
EMAIL_PROVIDER="smtp"

# بازار سایت: IRAN یا INTERNATIONAL (پیش‌فرض IRAN)
NEXT_PUBLIC_MARKET="IRAN"

# نوتیفِ واقعیِ Web Push (یادآوریِ برنامه/تمرین، حتی وقتی اپ کاملاً بسته‌ست).
# کلیدها رو با این دستور بساز (روی همین سرور یا لپ‌تاپت، فرقی نداره):
#   npx web-push generate-vapid-keys
# هرچی گرفتی رو دقیقاً همین‌جا بذار — publicKey با NEXT_PUBLIC_ (چون سمتِ
# مرورگر هم لازمه)، privateKey فقط سمتِ سرور. subject یه mailto: واقعیه که
# سرویس‌های Push (گوگل/موزیلا) در صورتِ سوءاستفاده باهاش تماس می‌گیرن.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# رمزِ محافظِ روتِ /api/push/send-reminders — این روت رو یه crontabِ بیرونی
# (نه خودِ کاربر) صدا می‌زنه، پس بدونِ این رمز هرکسی می‌تونست بی‌نهایت پوش
# بفرسته. با openssl rand -hex 24 بساز، و دقیقاً همین رشته رو توی هدرِ
# Authorization: Bearer <همین رمز> که crontab می‌فرسته هم بذار — مثال کاملِ
# راه‌اندازیِ crontab توی README/راهنمای دیپلوی هست.
CRON_SECRET=""

# درگاه پرداخت زرین‌پال — فقط بازارِ ایران/ریال پشتیبانی می‌شه. مرچنت‌آیدی
# از پنلِ زرین‌پال (zarinpal.com → پذیرندگان → وب‌سرویس) گرفته می‌شه. بدونِ
# این مقدار، چک‌اوت با پیامِ صادقانه‌ی «درگاه هنوز راه‌اندازی نشده» رد می‌شه،
# نه یه خطای خامِ ۵۰۰.
ZARINPAL_MERCHANT_ID=""
