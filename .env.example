# ─────────────────────────────────────────────────────────────────────────
# Arion — نمونه‌ی متغیرهای محیطی
#
#   cp .env.example .env    و بعد مقدارها را پر کن.
#
# فقط بخشِ «الزامی» برای بالا آمدن سایت لازم است؛ بقیه هرکدام یک قابلیتِ
# جداست و اگر خالی بماند همان قابلیت خاموش می‌شود (اپ crash نمی‌کند).
# ⚠️ این فایل خودش هیچ رمزی ندارد و توی گیت است؛ `.env` واقعی هیچ‌وقت
#    commit نمی‌شود (در .gitignore هست).
# ─────────────────────────────────────────────────────────────────────────

# ══ الزامی ═══════════════════════════════════════════════════════════════

# رمز دیتابیس. docker-compose خودش DATABASE_URL را از روی همین می‌سازد.
# روی سرور با یک رمز تصادفی پرش کن:  openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_USER=routine
POSTGRES_DB=routine

# کلید امضای نشست (JWT). حتما تصادفی:  openssl rand -hex 32
# ⚠️ عوض‌کردنش یعنی همه‌ی کاربرها یک‌باره از حساب بیرون می‌افتند.
NEXTAUTH_SECRET=

# آدرس کامل سایت، با https و بدون اسلش آخر.
NEXTAUTH_URL=https://example.com
NEXT_PUBLIC_SITE_URL=https://example.com

# ادمین اولیه — فقط موقع seed خوانده می‌شود. اگر خالی باشد هیچ ادمینی
# ساخته نمی‌شود. بعد از اولین ورود، رمز را از پنل عوض کن.
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=

# ══ پشتِ nginx / Cloudflare ══════════════════════════════════════════════

# اگر یک پروکسی (nginx یا Cloudflare) جلوی اپ است روی 1 بگذار، وگرنه
# rate limiting همه‌ی کاربرها را یک IP می‌بیند و ورود برای همه قفل می‌شود.
TRUST_PROXY_HEADERS=1

# کوکی نشست پیش‌فرض فقط روی https ست می‌شود. فقط برای یک دیپلویِ
# آزمایشیِ بدون TLS روی 0 بگذار.
# AUTH_COOKIE_SECURE=1

# ══ اندازه‌ی سرور ════════════════════════════════════════════════════════

# تعداد workerهای cluster.js و سقف heap هر کدام. قاعده‌ی سرانگشتی:
# WEB_CONCURRENCY × NODE_HEAP_MB کمتر از نصف رم سرور.
WEB_CONCURRENCY=2
NODE_HEAP_MB=512

# سقف کانکشن Prisma به ازای هر worker (پیش‌فرض خودکار حساب می‌شود).
# DB_CONNECTION_LIMIT=
# DB_POOL_TIMEOUT=20
# DB_CONNECT_TIMEOUT=10

# ══ کرون‌ها ══════════════════════════════════════════════════════════════

# رمز محافظِ روت‌های /api/cron/* و /api/push/send-reminders.
# openssl rand -hex 32   — همین مقدار باید در crontab هم بیاید.
# بدون این، همگام‌سازی خودکار تقویم اقتصادی هم خاموش است.
CRON_SECRET=

# ══ نوتیفیکیشن (Web Push) ════════════════════════════════════════════════

# با  npx web-push generate-vapid-keys  ساخته می‌شوند.
# ⚠️ بعد از انتشار عوضشان نکن: همه‌ی اشتراک‌های موجود بی‌صدا باطل می‌شوند.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ══ پیامک — ملی‌پیامک (اختیاری) ══════════════════════════════════════════

# بدون این‌ها کد OTP ارسال نمی‌شود و فقط توی لاگ سرور چاپ می‌شود
# (یعنی ثبت‌نام/فراموشی رمز عملا کار نمی‌کند).
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_PATTERN_ID=

# ══ ایمیل (اختیاری — برای تغییر ایمیل و کد ورود) ═════════════════════════

EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Arion <no-reply@example.com>

# ══ قابلیت‌های AI — گیت‌وی آروان‌کلود (اختیاری) ══════════════════════════

# بدون این‌ها رودمپ‌ساز، برنامه‌ی ورزشی AI، اسکن غذا و دستیار روتین
# خاموش‌اند (بقیه‌ی اپ سالم کار می‌کند).
ARVAN_AI_BASE_URL=
ARVAN_AI_API_KEY=
# مدل گزارش هفتگی (پیش‌فرض: gpt-5.4-mini)
# ARVAN_AI_WEEKLY_MODEL=
# ورودی صوتیِ دستیار (speech-to-text) — اگر خالی بماند فقط تایپ کار می‌کند
# ARVAN_AI_STT_URL=
# ARVAN_AI_STT_API_KEY=
# ARVAN_AI_STT_MODEL=whisper-1

# ══ پرداخت — زیبال (اختیاری) ═════════════════════════════════════════════

# بدون این، خرید اشتراک کار نمی‌کند (بقیه‌ی اپ سالم است).
ZIBAL_MERCHANT_KEY=

# ══ سئو — وریفیکیشن و ایندکس فوری (اختیاری) ══════════════════════════════

# کلید IndexNow — برای اطلاع فوری به Bing/Yandex از تغییرِ صفحه‌ها.
# هر رشته‌ی دلخواه (مثلا  openssl rand -hex 16 ). بعد از ست‌کردن، همین
# مقدار خودکار روی /indexnow-key.txt هم سرو می‌شه.
INDEXNOW_KEY=

# کدهای وریفیکیشن مالکیتِ سایت — هرکدوم رو از پنل همون سرویس می‌گیری و
# فقط همون تگ متا رو توی <head> اضافه می‌کنه؛ خالی بمونه چیزی رندر نمی‌شه.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_VERIFICATION=

# ══ تقویم اقتصادی (اختیاری) ═══════════════════════════════════════════════

# اختیاری. اولویتِ منبع: این کلید → بدونِ کلید: TradingView (بدونِ کلید،
# actual داره) → اگه TradingView در دسترس نبود: فارکس‌فکتوریِ رایگان
# (پشتیبان، actual نداره). یعنی بدونِ هیچ‌کدام هم تقویم خودکار پر می‌شود،
# هیچ کارِ ادمینی لازم نیست. کلیدِ JBlanked فقط بازه‌ی جلوتر (تا یک ماه) و
# دسته‌بندیِ بهتر می‌دهد. کلید از jblanked.com/profile.
# ECONOMIC_CALENDAR_API_KEY=
# فقط برای عوض‌کردنِ کاملِ منبع به یک فیدِ دیگر لازم است:
# ECONOMIC_CALENDAR_URL=
# ECONOMIC_CALENDAR_SOURCE=
# نکته: جدا از هر کران، خودِ روتِ خواندنِ تقویم هم داده‌ی کهنه را خودکار
# تازه می‌کند (ensureFreshCalendar) — پس تقویم به هیچ کران/crontab بیرونی
# وابسته نیست.
