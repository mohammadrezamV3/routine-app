# این فایل رو با دامنه‌ی خودت جایگزین کن و توی
# /etc/nginx/sites-available/routine-app بذار (راهنمای کامل در چت).
#
# نسخه‌ی هماهنگ با Cloudflare: چون Cloudflare جلوی سایت پروکسیِ HTTPS
# می‌کنه (SSL/TLS mode = Flexible)، اینجا فقط پورت ۸۰/HTTP لازمه —
# نیازی به certbot نیست، Cloudflare خودش گواهیِ رایگان به بازدیدکننده می‌ده.
#
# نکته‌ی امنیتیِ مهم: وقتی Cloudflare جلوی سایته، IPِ واقعیِ بازدیدکننده
# توی هدرِ CF-Connecting-IP میاد، نه $remote_addr (که IP خودِ Cloudflare
# می‌شه). این هدر رو به X-Forwarded-For پاس می‌دیم تا rate limiting سمتِ
# اپ (lib/rateLimit.ts، با TRUST_PROXY_HEADERS=1) درست کار کنه.

map $http_cf_connecting_ip $real_client_ip {
    default         $http_cf_connecting_ip;
    ""              $remote_addr;
}

# ⚠️ اگه سایت «گاهی بالا نمیاد و با چندبار ریلود درست می‌شه»، اول همین بخش
# رو روی سرورِ خودت (/etc/nginx/sites-available/routine-app) چک کن — به‌روز
# شدنِ این فایلِ نمونه توی گیت، فایلِ زنده‌ی سرور رو عوض نمی‌کنه.
#
# باگِ کلاسیکِ nginx که قبلاً این‌جا بود: `proxy_set_header Connection "upgrade"`
# به‌صورت ثابت روی *همه‌ی* درخواست‌ها ست شده بود، نه فقط WebSocket. برای یه
# درخواستِ HTTPِ معمولی (که $http_upgrade خالیه) این یعنی nginx به Node
# می‌گه «این کانکشن داره upgrade می‌شه» — نتیجه‌ش خراب‌شدنِ keep-alive و
# کانکشن‌هایی که بی‌دلیل باز می‌مونن/نیمه‌کاره بسته می‌شن. دقیقاً همون رفتارِ
# «گاهی بالا نمیاد، ریلود می‌زنم درست می‌شه».
#
# این اپ اصلاً WebSocket نداره (چتِ نمادها با polling کار می‌کنه، نه ws)، پس
# دیگه اصلاً هدرِ Upgrade رو پاس نمی‌دیم و کلِ این دسته باگ بسته می‌شه —
# به‌جاش `Connection ""` می‌ذاریم تا کانکشن‌پولِ keepaliveِ بالا واقعاً
# استفاده بشه (وگرنه برای هر درخواست یه TCP handshakeِ تازه زده می‌شه).

# کانکشن‌پولِ keep-alive به سمتِ Next — بدونِ این، nginx برای *هر* درخواست یه
# TCP handshake تازه به 127.0.0.1:3000 می‌زنه.
upstream nextjs_upstream {
    server 127.0.0.1:3000;
    keepalive 64;
}

server {
    listen 80;
    listen [::]:80;
    server_name your-domain.example www.your-domain.example;

    # فشرده‌سازی — بزرگ‌ترین بخشِ payloadِ این اپ JS و CSSه.
    gzip on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 512;
    gzip_vary on;
    gzip_types text/plain text/css application/json application/javascript
               application/x-javascript text/javascript image/svg+xml
               application/manifest+json font/woff2;

    # دارایی‌های استاتیکِ نکست هش‌دار هستن (اسمشون با هر build عوض می‌شه)،
    # پس می‌شه تا ابد کششون کرد — این‌جوری مرورگرِ بازدیدکننده‌ی برگشتی
    # اصلاً به Node نمی‌رسه.
    location /_next/static/ {
        proxy_pass http://nextjs_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    location /_next/image {
        proxy_pass http://nextjs_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        add_header Cache-Control "public, max-age=86400";
        access_log off;
    }

    # روت‌های پرداخت باید مهلتِ بیشتری داشته باشند: این‌ها منتظرِ پاسخِ یک
    # درگاهِ *بیرونی* (زیبال/زرین‌پال) می‌مانند، و درگاه‌های ایرانی در ساعاتِ
    # شلوغ می‌توانند چند ثانیه طول بکشند.
    #
    # با ۱۵ ثانیه‌ی پیش‌فرضِ `location /`، یک درگاهِ کند باعث می‌شد nginx اتصال
    # را ببندد و یک صفحه‌ی **HTML** با کدِ ۵۰۴ بدهد؛ کلاینت که منتظرِ JSON بود
    # روی `res.json()` خطا می‌خورد و کاربر پیامِ گمراه‌کننده‌ی «مشکلی در اتصال
    # به سرور پیش اومد» را می‌دید — بدونِ هیچ سرنخی از دلیلِ واقعی.
    #
    # خودِ اپ تایم‌اوتِ ۱۲ ثانیه‌ای روی فراخوانیِ درگاه دارد (lib/zibal.ts و
    # lib/zarinpal.ts)، پس این عدد فقط باید از آن *بیشتر* باشد تا همیشه اپ
    # زودتر تصمیم بگیرد و یک خطای JSONِ فارسیِ دقیق برگرداند.
    # روت‌های هوش مصنوعی (گزارش هفتگی، رودمپ‌ساز) ذاتاً کندند — تولیدِ متن
    # چند ده ثانیه طول می‌کشد. با ۱۵ ثانیه‌ی `location /` این‌ها همیشه از
    # سمتِ nginx کشته می‌شدند و یک ۵۰۴ـِ HTML می‌دادند، که کلاینت نمی‌توانست
    # پارسش کند و کاربر «مشکلی در اتصال به سرور» می‌دید.
    # خودِ اپ تایم‌اوتِ ۴۵ ثانیه‌ای دارد (lib/aiClient.ts)، پس این باید از آن
    # بیشتر باشد تا همیشه اپ زودتر تصمیم بگیرد و خطای فارسیِ JSON برگرداند.
    location ~ ^/api/(reports|roadmaps)/ {
        proxy_pass http://nextjs_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    location ~ ^/api/(subscription|payment)/ {
        proxy_pass http://nextjs_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $real_client_ip;
        proxy_set_header X-Forwarded-For $real_client_ip;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }

    location / {
        proxy_pass http://nextjs_upstream;
        proxy_http_version 1.1;
        # عمداً هدرِ Upgrade پاس داده نمی‌شه (بالا توضیح داده شده) و
        # `Connection ""` یعنی keepalive به سمتِ Node فعال بمونه.
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $real_client_ip;
        proxy_set_header X-Forwarded-For $real_client_ip;
        proxy_set_header X-Forwarded-Proto https;

        # پیش‌فرضِ nginx برای این‌ها ۶۰ ثانیه‌ست؛ یعنی اگه Node یه لحظه گیر
        # کنه، بازدیدکننده یک دقیقه‌ی تمام روی صفحه‌ی سفید می‌مونه. ۱۵ ثانیه
        # برای این اپ سخاوتمندانه‌ست (کندترین روتِ واقعی، ساختِ رودمپ با AI،
        # خودش سمتِ کلاینت لودینگ نشون می‌ده).
        proxy_connect_timeout 5s;
        proxy_send_timeout 15s;
        proxy_read_timeout 15s;
    }

    client_max_body_size 10m;
}

# ─────────────────────────────────────────────────────────────────────────
# دیباگِ «سایت بالا نمیاد»: دو روتِ سلامت داریم و تفاوتشون مهمه —
#   curl -s http://127.0.0.1:3000/api/health   → فقط می‌گه پروسه‌ی Node زنده‌ست
#   curl -s http://127.0.0.1:3000/api/ready    → واقعاً به Postgres کوئری می‌زنه
# اگه health سالم بود ولی ready با reason:"timeout" برگشت، یعنی کانکشن‌پولِ
# دیتابیس پُر شده (نه اینکه Node مرده باشه). اسکریپتِ scripts/diagnose-uptime.sh
# همه‌ی این‌ها رو یک‌جا چک می‌کنه.
