{
  "compilerOptions": {
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "tailwindcss": ["./node_modules/tailwindcss"]
    }
  },
  "include": ["vite.config.ts", "capacitor.config.ts", "tailwind.config.ts", "tooling/*.ts"]
}
