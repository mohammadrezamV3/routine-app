# آدرسِ بک‌اندِ Next.js (بدونِ اسلشِ آخر) — اپ از /api/mobile/* همین سرور
# برای ورود و همگام‌سازی استفاده می‌کنه. در زمانِ build داخلِ باندل جا می‌گیره.
#
# خالی بذاری = اپ کاملا محلی/مهمان کار می‌کنه (بدونِ ورود و سینک).
#
# نمونه‌ها:
#   production:        VITE_API_BASE_URL=https://arion.example.com
#   توسعه در مرورگر:   VITE_API_BASE_URL=http://localhost:3000
#     (سرورِ dev ِ Next اجازه‌ی CORS از http://localhost:5173 رو می‌ده — middleware.ts)
#   امولاتورِ اندروید: VITE_API_BASE_URL=http://10.0.2.2:3000
#     (نیاز به allowMixedContent/cleartext در اندروید داره؛ برای production فقط https)
VITE_API_BASE_URL=
