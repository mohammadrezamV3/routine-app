// ============================================================================
// PRISMA SCHEMA — پلتفرم روتین/سلامت/ترید چندپلنی و دو-بازاری
// ============================================================================
// طراحی‌شده برای:
//  - دو بازار مستقل (ایران/تومان و بین‌المللی/دلار) زیر یک دیتابیس
//  - ۴ پلن قابل‌ترکیب (پایه، ورزش، ترید، مکس) بدون هاردکد کردن منطق دسترسی
//  - رفرال کاربر-به-کاربر + قرارداد باشگاه (٪سهم و ٪تخفیف)
//  - سقف مصرف ماهانه AI (Haiku برای ایران، Sonnet برای بین‌المللی)
//  - هر ماژول محصول (روتین، خواب، کار روزمره، ورزش، کالری، ترید، رودمپ) کاملاً مجزا
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum Market {
  IRAN
  INTERNATIONAL
}

enum Currency {
  IRR
  USD
}

enum AiModel {
  HAIKU  // بازار ایران — ارزون‌تر
  SONNET // بازار بین‌المللی
}

enum ModuleKey {
  ROUTINE   // روتین/چک‌لیست روزانه — همیشه در پلن پایه
  SLEEP     // خواب — همیشه در پلن پایه
  TASKS     // کارهای روزمره — همیشه در پلن پایه
  EXERCISE  // ورزش
  CALORIE   // کالری
  TRADE     // ژورنال ترید
  ROADMAP   // رودمپ آموزشی — همراه با پلن مکس یا جدا، به‌صورت پیکربندی‌شده
  AI_INSIGHT // Correlation Insight — فقط پلن مکس
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum ReferralUsageStatus {
  PENDING    // ثبت شده ولی هنوز شرط تکمیل (مثلاً اولین پرداخت) برقرار نشده
  REWARDED   // پاداش (ماه رایگان / سهم باشگاه) اعمال شده
  REVOKED    // به هر دلیل باطل شده (مثلاً استرداد وجه)
}

enum PartnerType {
  GYM
  OTHER
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

enum AiFeatureKey {
  DAILY_BRIEFING
  WEEKLY_COACH_REPORT
  CORRELATION_INSIGHT
  ROADMAP_GENERATION
  EXERCISE_PLAN_GENERATION
  FOOD_SCAN
}

// سطح شدت یک رخداد خطای واقعی (نه ساختگی) که سیستم ثبت کرده
enum ErrorSeverity {
  WARNING
  ERROR
  CRITICAL
}

// ============================================================================
// USER & AUTH
// ============================================================================

model User {
  id            String   @id @default(cuid())
  email         String?  @unique
  phone         String?  @unique
  username      String?  @unique
  passwordHash  String?
  name          String?
  lastName      String?
  avatarUrl     String?
  birthDate     DateTime?
  gender        String?  // "male" | "female" | null — اختیاری، فقط اگه کاربر خودش پر کنه
  // پروفایل — مستقل از اسنپ‌شاتِ heightCm/weightKgِ خودِ ExercisePlan/CalorieTarget
  // (که لحظه‌ی محاسبه رو ثبت می‌کنن)؛ این‌جا مقدارِ فعلیِ کاربره که از پروفایل ویرایش می‌شه.
  heightCm      Int?
  weightKg      Float?

  // پنل کاربری › حریم خصوصی: خاموش‌کردنش یعنی توی جست‌وجوی دوستان (/api/friends/search) دیده نشه
  discoverable  Boolean  @default(true)
  // ساختارِ آماده برای ۲مرحله‌ای — فعلاً فقط پرچمه، فلوی فعال‌سازی/کدِ OTP هنوز پیاده نشده
  twoFactorEnabled Boolean @default(false)

  // سوپریوزر/ادمین — دسترسی نامحدود به همه ماژول‌ها بدون نیاز به اشتراک
  isSuperAdmin  Boolean  @default(false)

  // پنل Owner › کاربران › مسدودکردن — کاربرِ مسدودشده نمی‌تونه لاگین کنه
  // (چک در authorize())؛ soft-delete نیست، فقط جلوی ورود رو می‌گیره
  isBlocked     Boolean  @default(false)
  blockedAt     DateTime?

  market        Market   // بازار کاربر — تعیین‌کننده ارز/پلن/مدل AI/زبان پیش‌فرض
  locale        String   @default("fa") // fa | en
  timezone      String   @default("Asia/Tehran")

  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime? // soft delete برای نگهداری تاریخچه مالی/رفرال

  // روابط احراز هویت
  accounts      OAuthAccount[]
  sessions      Session[]
  loginEvents   LoginEvent[]
  passwordResetOtps PasswordResetOtp[]
  tradeChecklistItems TradeChecklistItem[]

  // روابط تجاری
  subscriptions       Subscription[]
  moduleAccess         ModuleAccess[]
  aiUsage              AiUsageRecord[]

  // رفرال — کد خودِ کاربر برای دعوت دیگران
  referralCode         ReferralCode?
  referralUsagesAsInvitee  ReferralUsage[] @relation("InviteeUsages")

  // اگر کاربر از طریق باشگاه اومده
  gymPartnerId         String?
  gymPartner           Partner? @relation("GymUsers", fields: [gymPartnerId], references: [id])

  // داده‌های ماژول‌ها
  dailyEntries      DailyEntry[]
  sleepEntries      SleepEntry[]
  tasks             Task[]
  exercisePlans     ExercisePlan[]
  exerciseLogs      ExerciseLog[]
  foodLogs          FoodLogEntry[]
  calorieTargets    CalorieTarget[]
  tradeEntries      TradeEntry[]
  roadmaps          Roadmap[]
  notepadPages      NotepadPage[]

  userSettings      UserSetting[]
  exportRequests    ExportRequest[]
  sharedLinks       SharedProgressLink[]
  pushSubscriptions PushSubscription[]

  // دوستان — درخواست‌های فرستاده‌شده/دریافت‌شده (یک ردیف Friendship به‌ازای هر جفت)
  friendRequestsSent     Friendship[] @relation("FriendRequestsSent")
  friendRequestsReceived Friendship[] @relation("FriendRequestsReceived")

  @@index([market])
  @@index([gymPartnerId])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String   // google | apple | ...
  providerAccountId String
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
}

// لاگِ append-only هر ورودِ موفق — پنل کاربری › امنیت › «ورودهای اخیر».
// این پروژه از session استراتژیِ JWT استفاده می‌کنه (بدونِ ردیفِ سرورِ فعال به‌ازای
// هر توکن)، پس این جدول یک «سابقه‌ی ورود» واقعیه، نه یک لیستِ session قابل‌ابطال —
// چیزی که مدل Session بالا برای‌ش ساخته شده ولی الان استفاده نمی‌شه.
model LoginEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String   // "credentials" | "google"
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// چک‌لیست شخصی پیش از معامله — کاملاً دست‌ساز کاربره (نه قالب ثابت)، حداکثر
// ۴۰ آیتم، ترتیبش با «order» مشخص می‌شه و از پنل ترید قابل ویرایش/جابه‌جایی‌ست
model TradeChecklistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// کد یک‌بارمصرف فراموشی رمز — پیامکی به شماره کاربر می‌ره. کد به‌صورت هش‌شده
// ذخیره می‌شه (نه متن خام)، محدود به چند تلاش (جلوگیری از حدس‌زدن brute-force
// روی یه کد ۵رقمی)، و بعد از انقضا/مصرف دیگه معتبر نیست.
model PasswordResetOtp {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// کد یک‌بارمصرف تاییدِ شماره موبایل موقعِ ثبت‌نام — برخلافِ PasswordResetOtp
// به یک User موجود وصل نیست (چون کاربر هنوز ساخته نشده)، فقط به خودِ شماره.
// verifiedAt یعنی کاربر کد رو درست وارد کرده؛ usedAt یعنی همون تاییدیه واقعاً
// برای ساختِ یک حساب مصرف شده (جلوگیری از استفاده‌ی دوباره‌ی یک تاییدیه‌ی
// قدیمی برای چند ثبت‌نام).
model SignupOtp {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  verifiedAt DateTime?
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone])
}

// ورودِ بدونِ رمز با کدِ ایمیل — دقیقاً همون الگوی SignupOtp (کلید رشته‌ی
// خام email، نه userId، چون در لحظه‌ی درخواست نباید فاش بشه که این ایمیل
// حسابِ کاربری داره یا نه — همون قرارداد ضدِenumeration بقیه‌ی سایت).
// verifiedAt = کدِ درست وارد شده (مرحله‌ی پیش‌بررسیِ فرانت)؛ usedAt = واقعاً
// برای صدورِ نشست مصرف شده (توسطِ authorize()ی provider «email-otp» توی
// lib/auth.ts). این جداسازی یعنی هیچ پیام سفارشی‌ای لازم نیست از دلِ
// authorize()ِ NextAuth (که پیام‌های سفارشی رو نگه نمی‌داره) رد بشه.
model EmailLoginOtp {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  verifiedAt DateTime?
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
}

// تغییرِ ایمیل از پنل کاربری — برخلافِ EmailLoginOtp (که به یک ایمیلِ خام
// وصله و برای ورودِ بدونِ‌رمزه)، این‌جا به یک userIdِ لاگین‌شده وصله؛ کد به
// newEmail (ایمیلِ جدید، نه فعلی) فرستاده می‌شه تا مالکیتِ ایمیلِ جدید
// اثبات بشه — دقیقاً همون دلیلی که تغییرِ مستقیمِ بدونِ تایید امن نبود.
model EmailChangeOtp {
  id         String    @id @default(cuid())
  userId     String
  newEmail   String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// ============================================================================
// PLANS, PRICING & SUBSCRIPTIONS
// ============================================================================

// یک "Plan" فقط یک قالب تجاری/قیمتی‌ست. اینکه کدام ماژول‌ها را باز می‌کند
// در PlanModule تعریف می‌شود، نه هاردکد در کد — همین باعث می‌شود اگر بعداً
// پلن‌بندی عوض شد (مثلاً ماژول جدید یا تغییر ترکیب)، فقط داده تغییر کند.
model Plan {
  id            String   @id @default(cuid())
  key           String   // "basic" | "exercise" | "trade" | "max"
  nameFa        String
  nameEn        String

  market        Market   // هر پلن مخصوص یک بازار تعریف می‌شود (قیمت‌گذاری جدا)
  currency      Currency

  priceMonthly  Int      // به کوچک‌ترین واحد ارز (ریال برای IRR، سنت برای USD) تا خطای اعشار نداشته باشیم
  priceYearly   Int?

  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  modules       PlanModule[]
  subscriptions Subscription[]

  @@unique([key, market])
  @@index([market])
}

model PlanModule {
  id       String    @id @default(cuid())
  planId   String
  plan     Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  module   ModuleKey

  @@unique([planId, module])
}

model Subscription {
  id              String              @id @default(cuid())
  userId          String
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId          String
  plan            Plan                @relation(fields: [planId], references: [id])

  status          SubscriptionStatus  @default(TRIAL)
  interval        BillingInterval     @default(MONTHLY)

  startDate       DateTime            @default(now())
  currentPeriodEnd DateTime
  canceledAt      DateTime?
  trialEndsAt     DateTime?

  // درصد تخفیف اعمال‌شده از قرارداد باشگاه یا کد تخفیف (مثلاً ۱۰٪ = 10)
  discountPercent Int                 @default(0)
  appliedReferralUsageId String?
  appliedReferralUsage   ReferralUsage? @relation(fields: [appliedReferralUsageId], references: [id])

  payments        Payment[]

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([userId])
  @@index([status])
}

model Payment {
  id             String   @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  amount         Int      // واحد کوچک ارز، بعد از اعمال تخفیف
  currency       Currency
  provider       String   // zarinpal | stripe | ...
  providerRef    String?  // شناسه تراکنش سمت درگاه

  // برای محاسبه سهم باشگاه از سود واقعی، نه از قیمت لیست
  gymRevenueShareAmount Int? // مبلغی که باید به باشگاه پرداخت شود (۱۵٪ سهم)

  paidAt         DateTime?
  refundedAt     DateTime?
  createdAt      DateTime @default(now())

  @@index([subscriptionId])
}

// دسترسی محاسبه‌شده به هر ماژول — این جدول را یک job/webhook بعد از هر تغییر
// در Subscription دوباره می‌سازد. کد سمت اپ فقط همین جدول را چک می‌کند و
// هیچ‌وقت مستقیماً به Plan/PlanModule وابسته نیست.
model ModuleAccess {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  module    ModuleKey
  active    Boolean   @default(false)
  expiresAt DateTime? // برای دسترسی موقت trial یا گریس‌پیریود بعد از لغو

  updatedAt DateTime  @updatedAt

  @@unique([userId, module])
  @@index([userId])
}

// ============================================================================
// REFERRAL & GYM PARTNERSHIP
// ============================================================================

model ReferralCode {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String   @unique
  createdAt DateTime @default(now())

  usages    ReferralUsage[] @relation("CodeUsages")
}

model ReferralUsage {
  id              String               @id @default(cuid())
  referralCodeId  String
  referralCode    ReferralCode         @relation("CodeUsages", fields: [referralCodeId], references: [id])

  inviteeUserId   String
  inviteeUser     User                 @relation("InviteeUsages", fields: [inviteeUserId], references: [id])

  status          ReferralUsageStatus  @default(PENDING)

  // پاداش هر دو طرف: یک ماه رایگان — این مقدار وقتی status=REWARDED می‌شود اعمال می‌گردد
  inviterRewardApplied  Boolean @default(false)
  inviteeRewardApplied  Boolean @default(false)

  subscriptions   Subscription[] // اشتراک‌هایی که این کد تخفیف را گرفتند

  createdAt       DateTime             @default(now())
  rewardedAt      DateTime?
  revokedAt       DateTime?

  @@index([inviteeUserId])
  @@index([referralCodeId])
}

// کدهای تخفیفِ عمومی که سوپرادمین از پنل ادمین می‌سازه — جدا از ReferralCode
// (که شخصیه، هرکاربر یکی داره، برای دعوت دوستانه). این‌ها با دست ساخته
// می‌شن، می‌تونن منقضی بشن، و می‌تونن فقط روی یک پلنِ خاص اعمال بشن.
model DiscountCode {
  id         String    @id @default(cuid())
  code       String    @unique
  percentOff Int
  // null یعنی روی همه‌ی پلن‌ها اعمال می‌شه؛ در غیر این صورت فقط همون کلیدِ پلن
  // (مثلاً "exercise") — همون Plan.key، نه یه رابطه‌ی FK، چون یک کلید توی هر
  // دو بازار (Market) به‌طور بالقوه پلنِ جدا داره و این کد فعلاً فقط بازارِ
  // ایران رو پوشش می‌ده (همون محدودیتِ چک‌اوتِ فعلی).
  planKey    String?
  expiresAt  DateTime?
  active     Boolean   @default(true)
  // null یعنی هر کاربر بدونِ محدودیت می‌تونه این کد رو مصرف کنه؛ عددِ مشخص
  // یعنی سقفِ تعدادِ دفعاتِ مصرفِ این کد برای هر کاربر (رکوردش توی
  // DiscountCodeUsage، یکی به‌ازای هر خریدِ موفقِ verify-شده).
  maxUsesPerUser Int?
  createdAt  DateTime  @default(now())
  usages     DiscountCodeUsage[]

  @@index([code])
}

// یک ردیف به‌ازای هر مصرفِ موفقِ یک DiscountCode توسط یک کاربر — فقط موقعِ
// verify شدنِ واقعیِ پرداخت ثبت می‌شه (app/api/subscription/verify)، نه
// موقعِ پیش‌نمایش/اعمال توی چک‌اوت. شمارشِ همین ردیف‌ها برای هر
// (discountCodeId, userId) در برابرِ maxUsesPerUser چک می‌شه.
model DiscountCodeUsage {
  id             String       @id @default(cuid())
  discountCodeId String
  discountCode   DiscountCode @relation(fields: [discountCodeId], references: [id])
  userId         String
  usedAt         DateTime     @default(now())

  @@index([discountCodeId, userId])
}

// باشگاه یا هر شریک تجاری دیگر
model Partner {
  id                String      @id @default(cuid())
  type              PartnerType @default(GYM)
  name              String
  contactPhone      String?
  contactEmail      String?

  market            Market

  revenueSharePercent Int       @default(15) // سهم باشگاه از سود واقعی
  userDiscountPercent Int       @default(10) // تخفیف به کاربرانی که از این باشگاه می‌آیند

  isActive          Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  users             User[]      @relation("GymUsers")

  @@index([market])
}

// ============================================================================
// AI USAGE (Daily Briefing / Weekly Coach / Correlation Insight)
// ============================================================================

model AiUsageRecord {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  feature      AiFeatureKey
  // نامِ واقعیِ مدلِ فراخوانی‌شده (مثلاً "gpt-4o-mini") — enum قدیمیِ
  // AiModel (Haiku/Sonnet) مالِ زمانی بود که مستقیم به Anthropic وصل
  // بودیم؛ از وقتی همه از گیت‌وی آروان‌کلود با یک مدلِ ثابت رد می‌شن،
  // یک رشته‌ی خام دقیق‌تر و صادقانه‌تره تا یک enum که دیگه با واقعیت نمی‌خونه.
  model        String

  inputTokens  Int          @default(0)
  outputTokens Int          @default(0)
  costUsdMicros Int         @default(0) // هزینه‌ی تخمینی به میکرو-دلار (بر اساس نرخِ قابل‌تنظیمِ AppSetting)

  success      Boolean      @default(true) // false یعنی فراخوانی/تولید شکست خورد (برای نرخ خطا در پنل Owner)
  durationMs   Int?         // زمانِ واقعیِ پاسخ‌گیریِ گیت‌وی — برای بخشِ وضعیتِ سیستم

  // خروجی همیشه باید صراحتاً "پیشنهاد" باشد؛ این پرچم برای ممیزی محتوای تولیدشده
  // (مثلاً بررسی دستی نمونه‌ای که آیا زبان دستوری/توصیه پزشکی درش نشت کرده) نگه داشته می‌شود
  flaggedForReview Boolean   @default(false)

  createdAt    DateTime     @default(now())

  @@index([userId, feature, createdAt])
  @@index([feature, createdAt])
}

// سقف مصرف ماهانه هر کاربر برای هر فیچر AI — جلوگیری از هزینه کنترل‌نشده
model AiMonthlyQuota {
  id         String       @id @default(cuid())
  userId     String
  feature    AiFeatureKey
  yearMonth  String       // فرمت "2026-08" برای شمارش ساده بدون کوئری تاریخ پیچیده
  usedCount  Int          @default(0)
  limitCount Int          // بر اساس پلن کاربر ست می‌شود

  @@unique([userId, feature, yearMonth])
}

// ============================================================================
// MODULE: ROUTINE / DAILY CHECKLIST (هسته پایه — مبتنی بر همان منطق فایل HTML فعلی)
// ============================================================================

model RoutineItem {
  id         String   @id @default(cuid())
  userId     String
  // آیتم‌های تعریف‌شده توسط کاربر یا سیستم (مثل ترید/فرانسه/OWASP در نسخه فعلی)
  name       String
  // زمان‌بندی هفتگی به‌صورت JSON: [{jsDay, startMin, endMin}], تا از منطق سخت‌کدشده HTML جدا شود
  schedule   Json
  startDate  DateTime?
  endDate    DateTime?
  isActive   Boolean  @default(true)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model DailyEntry {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date // یک رکورد به‌ازای هر کاربر/روز

  // وضعیت تیک هر RoutineItem در آن روز: { [routineItemId]: boolean }
  completedItems Json  @default("{}")
  wakeUpAt   DateTime?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
}

// ============================================================================
// MODULE: FRIENDS (دوستان — مشاهده‌ی درصد پیشرفتِ روزانه‌ی هم)
// ============================================================================

// درخواست دوستی — requester تا وقتی addressee قبول نکنه PENDING می‌مونه.
// یکتا بر اساس جفت (requester, addressee) تا درخواست تکراری نره؛ دوستیِ
// دوطرفه یعنی یا این ردیف یا معکوسش با status=ACCEPTED وجود داره — کوئری‌ها
// همیشه هر دو جهت رو با OR چک می‌کنن (لیست دوستان/تشخیص already-friends).
model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  requester   User             @relation("FriendRequestsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User             @relation("FriendRequestsReceived", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(PENDING)

  // فیوریت‌بودن شخصیه، نه متقارن — رکورد Friendship یکی برای هر دو طرفه،
  // پس باید جدا نگه داریم که کدوم طرف این دوستی رو استار زده.
  favoritedByRequester Boolean @default(false)
  favoritedByAddressee Boolean @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([requesterId, addresseeId])
  @@index([requesterId])
  @@index([addresseeId])
}

// ============================================================================
// MODULE: SLEEP
// ============================================================================

model SleepEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date

  sleptAt   DateTime?
  wokeAt    DateTime?
  targetSleptAt DateTime? // هدف تعیین‌شده کاربر
  targetWokeAt  DateTime?

  quality   Int?     // ۱ تا ۵، اختیاری، خودارزیابی کاربر

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
}

// ============================================================================
// MODULE: TASKS (کارهای روزمره)
// ============================================================================

model Task {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title     String
  notes     String?
  dueDate   DateTime?
  priority  Int      @default(0)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, dueDate])
}

// ============================================================================
// MODULE: EXERCISE (سطوح مبتدی/متوسط/پیشرفته)
// ============================================================================

model ExercisePlan {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  level     String   // beginner | intermediate | advanced
  heightCm  Int?
  weightKg  Float?
  goal      String?  // مثلاً "کاهش وزن" | "افزایش قدرت"
  hasPhysicalLimitation Boolean @default(false) // چک‌باکس کلی، بدون جزئیات پزشکی
  disclaimerAcceptedAt  DateTime? // تیک تایید اجباری قبل از فعال‌سازی ماژول

  gymDays       Json?    // آرایه‌ای از نام فارسی روزهای هفته که کاربر باشگاه می‌ره، مثلاً ["شنبه","دوشنبه","چهارشنبه"]
  trainingPhase String?  // bulk | cut | maintenance | none
  generatedByAi Boolean  @default(false) // false یعنی از قالب ایستای lib/exercisePlans.ts ساخته شده (fallback بدون کلید API)

  startDate DateTime @default(now())
  isActive  Boolean  @default(true)

  // ساختار برنامه هفتگی/ماهانه به‌صورت JSON — یا از هوش مصنوعی، یا (fallback) از قالب ایستای از‌پیش‌طراحی‌شده
  planData  Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs      ExerciseLog[]

  @@index([userId])
}

model ExerciseLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId    String?
  plan      ExercisePlan? @relation(fields: [planId], references: [id])

  date      DateTime @db.Date
  completed Boolean  @default(false)
  // اسمِ حرکت‌هایی که حینِ همین جلسه تیک خوردن — برای نمایشِ ضربدرِ حرکاتِ
  // تیک‌نخورده بعدِ «پایان تمرین» و محاسبه‌ی درصدِ پیشرفتِ امروز.
  completedItems Json?
  notes     String?

  createdAt DateTime @default(now())

  @@unique([userId, planId, date])
  @@index([userId])
}

// ============================================================================
// MODULE: CALORIE (سخت‌ترین از نظر داده — نیاز دیتابیس غذایی)
// ============================================================================

model FoodItem {
  id          String   @id @default(cuid())
  nameFa      String
  nameEn      String?
  caloriesPer100g Float
  proteinPer100g  Float?
  carbsPer100g    Float?
  fatPer100g      Float?

  // منبع داده (برای رفع اختلاف/آپدیت بعدی)
  source      String?  // "internal" | "usda" | "user-submitted"
  verifiedAt  DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  logs        FoodLogEntry[]

  @@index([nameFa])
}

model FoodLogEntry {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodItemId String?
  foodItem   FoodItem? @relation(fields: [foodItemId], references: [id])

  // برای غذاهای سفارشی/دستی که در دیتابیس نیستند
  customName String?
  customCalories Float?

  date       DateTime @db.Date
  grams      Float
  mealType   String?  // breakfast | lunch | dinner | snack

  // درشت‌مغذی‌ها — فقط برای ثبت‌هایی که با اسکنِ عکسِ غذا با هوش مصنوعی
  // اومدن پر می‌شن (چون تخمینِ دقیقِ پروتئین/کربوهیدرات/چربی از روی عکس
  // نیاز به مدلِ AI داره، نه یه فرمولِ ساده)؛ برای ثبت‌های دستی/کاتالوگ
  // همیشه null می‌مونن. aiScanned مشخص می‌کنه کدوم ثبت از این مسیر اومده،
  // تا کارتِ خلاصه‌ی درشت‌مغذی‌ها بدونه کِی داده‌ی واقعی برای نمایش داره.
  proteinG   Float?
  carbsG     Float?
  fatG       Float?
  aiScanned  Boolean  @default(false)

  createdAt  DateTime @default(now())

  @@index([userId, date])
}

model CalorieTarget {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  dailyTargetKcal Int
  goal            String?  // lose | maintain | gain
  mealsPerDay     Int?
  mealBreakdown   Json?    // [{ key, label, kcal }] — جمعش باید با dailyTargetKcal برابر باشه
  sex             String?  // male | female — فقط برای محاسبه BMR، جای دیگه‌ای ذخیره نمی‌شه
  ageYears        Int?     // اگه User.birthDate نبود، همینجا مستقیم پرسیده و ذخیره می‌شه
  heightCm        Int?     // اسنپ‌شات قد/وزن لحظه‌ی محاسبه (مثل ExercisePlan)، برای محاسبه BMR
  weightKg        Float?

  effectiveFrom   DateTime @default(now())
  effectiveTo     DateTime?

  createdAt    DateTime @default(now())

  @@index([userId])
}

// ============================================================================
// MODULE: TRADE JOURNAL (فقط آمار خام — بدون تفسیر یا پیشنهاد سیستمی)
// ============================================================================

model TradeEntry {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  pair        String   // "EURUSD"
  direction   String   // long | short
  entryPrice  Float
  exitPrice   Float?
  lotSize     Float
  volume      Float?   // حجم معامله — جدا از لات، ورودی آزاد کاربر
  pnl         Float?   // سود/زیان — از قیمت ورود/خروج/لات/جهت معامله محاسبه می‌شه، ورودی دستی نیست
  riskPercent Float?
  stopLoss    Float?
  takeProfit  Float?
  strategy    String?  // تگ آزاد استراتژی/ستاپ معامله، مثلاً "بریک‌اوت"
  screenshotUrl String? // عکس چارت معامله به‌صورت data URL (بدون استوریج جدا)

  openedAt    DateTime
  closedAt    DateTime?
  notes       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, openedAt])
}

// ============================================================================
// MODULE: ROADMAP (رودمپ‌ساز — کاربر موضوع می‌دهد، سیستم/AI رودمپ می‌سازد)
// ============================================================================

model Roadmap {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  topic      String   // مثلاً "لایت‌روم" یا "مدیریت مالی"
  title      String
  note       String?

  // ساختار ایستگاه‌ها دقیقاً مطابق همان مدل treasure-map در HTML فعلی:
  // [{ title, items: [string], done: boolean }]
  stations   Json

  tips       Json?    // string[]
  proTips    Json?    // string[]
  books      Json?    // string[]

  generatedByAi Boolean @default(false)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

// ============================================================================
// SUPPORTING FEATURES (اعتمادسازی و اشتراک‌گذاری)
// ============================================================================

// ============================================================================
// MODULE: NOTEPAD (Workspace بلاک‌محورِ کامل — تنها بخشِ یادداشت/دانشِ اپ؛
// جایگزینِ کاملِ MODULE NOTESِ قدیمی که حذف شد. جزوِ پلنِ پایه‌ست (بدونِ
// ModuleGate). Phase 1: صفحاتِ تودرتو + ادیتورِ بلاکی. این یکی برای
// Workspaceِ واقعی/تودرتوئه. هر Page و هر Block شناسه‌ی مستقلِ خودشو داره
// (طبق درخواستِ صریح)، تا در آینده Sharing/Collaboration/Backlink/Relation
// با ماژول‌های دیگه‌ی Arion بشه بهش اضافه کرد بدونِ تغییرِ ساختار.
// ============================================================================

model NotepadPage {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // صفحاتِ تودرتو — یک صفحه می‌تونه زیرمجموعه‌ی صفحه‌ی دیگه‌ای باشه
  parentId     String?
  parent       NotepadPage?  @relation("NotepadPageChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children     NotepadPage[] @relation("NotepadPageChildren")

  title        String        @default("")
  icon         String?       // ایموجی
  coverUrl     String?       // data-URL فشرده، مثلِ الگوی آواتار — بدونِ storage ابری

  // موقعیتِ بین خواهر/برادرها — عددِ اعشاری تا افزودن/جابه‌جاییِ یک آیتم بینِ
  // دوتای دیگه بدونِ renumber کردنِ بقیه ممکن باشه
  position     Float         @default(0)
  isFavorite   Boolean       @default(false)
  isArchived   Boolean       @default(false) // یعنی توی Trash
  isLocked     Boolean       @default(false) // ادیت غیرفعاله تا وقتی از منوی Actions باز بشه
  archivedAt   DateTime?
  lastOpenedAt DateTime?

  blocks       NotepadBlock[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId])
  @@index([userId, parentId])
  @@index([userId, isFavorite])
  @@index([userId, isArchived])
  @@index([userId, lastOpenedAt])
}

model NotepadBlock {
  id            String        @id @default(cuid())
  pageId        String
  page          NotepadPage   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  // فقط برای بلاکِ Toggle معنی داره — بچه‌های تودرتوی همون بلاک. بدونِ FK
  // مستقیم به User (برای جلوگیری از خطای «چند مسیرِ cascade» توی پستگرس؛
  // مالکیت از طریقِ pageId.userId چک می‌شه، دقیقاً مثلِ بقیه‌ی روت‌های اپ)
  parentBlockId String?
  parent        NotepadBlock? @relation("NotepadBlockChildren", fields: [parentBlockId], references: [id], onDelete: Cascade)
  children      NotepadBlock[] @relation("NotepadBlockChildren")

  type          String        // "paragraph" | "heading1" | "heading2" | "heading3" |
                               // "bulleted_list" | "numbered_list" | "todo" | "toggle" |
                               // "quote" | "divider" | "image" | "database" | "code"
  // آرایه‌ی RichLeaf — [{ text, bold?, italic?, underline?, strike?, code?, link? }]
  content       Json          @default("[]")
  checked       Boolean       @default(false) // فقط برای todo
  collapsed     Boolean       @default(false) // فقط برای toggle
  imageUrl      String?       // فقط برای image — data-URL فشرده یا لینکِ خارجی
  language      String?       // فقط برای code — اسمِ زبان برای رنگ‌بندیِ نحوی

  position      Float         @default(0)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  database      NotepadDatabase?

  @@index([pageId])
  @@index([pageId, parentBlockId])
}

// ============================================================================
// NOTEPAD — Phase 2: Database (Table/Board/Calendar/Gallery/List). یک
// دیتابیس همیشه به یه بلاکِ type="database" وصله (نه مستقیم به Page) — یعنی
// هر صفحه می‌تونه چند دیتابیسِ inline داشته باشه، دقیقاً مثلِ Notion. مالکیت
// همه‌جا از طریقِ block.page.userId چک می‌شه (بدونِ FK مستقیم به User، طبقِ
// همون قاعده‌ی جلوگیری از چند-مسیر-cascade که بالا هم رعایت شده).
// ============================================================================

model NotepadDatabase {
  id        String   @id @default(cuid())
  blockId   String   @unique
  block     NotepadBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  name      String   @default("دیتابیس")
  activeView String  @default("table") // "table" | "board" | "calendar" | "gallery" | "list"

  // فیلتر/سورت/گروه‌بندی — مشترک بینِ همه‌ی ویوها (نه جدا برای هرکدوم، برای
  // سادگی)؛ Board/Calendar علاوه‌بر این، یه propertyِ اختصاصی برای
  // ستون‌بندی/تاریخ‌گذاری دارن
  filters   Json     @default("[]") // [{ propertyId, op, value }]
  sorts     Json     @default("[]") // [{ propertyId, dir: "asc"|"desc" }]
  hiddenPropertyIds Json @default("[]") // string[]
  boardGroupPropertyId    String?
  calendarDatePropertyId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties NotepadDatabaseProperty[]
  records    NotepadDatabaseRecord[]

  @@index([blockId])
}

model NotepadDatabaseProperty {
  id         String   @id @default(cuid())
  databaseId String
  database   NotepadDatabase @relation(fields: [databaseId], references: [id], onDelete: Cascade)

  name       String
  type       String   // "text" | "number" | "select" | "multi_select" | "checkbox" |
                       // "date" | "url" | "email" | "relation" | "formula"
  // select/multi_select: [{id,label,color}] — relation: {targetDatabaseId} —
  // formula: {expression}
  options    Json?
  position   Float    @default(0)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([databaseId])
}

model NotepadDatabaseRecord {
  id         String   @id @default(cuid())
  databaseId String
  database   NotepadDatabase @relation(fields: [databaseId], references: [id], onDelete: Cascade)

  // مقدارِ همه‌ی propertyها یک‌جا: { [propertyId]: value } — نوعِ value بسته
  // به نوعِ property فرق می‌کنه (string/number/boolean/string[]/ISO date)
  values     Json     @default("{}")
  position   Float    @default(0)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([databaseId])
}

// ============================================================================
// USER SETTINGS (key-value ساده برای بلاب‌های کوچک JSON — تم، occurrenceهای
// حذف/اضافه‌شده‌ی برنامه هفتگی و مواردی از این دست که مدل اختصاصی نمی‌خوان)
// ============================================================================

// ============================================================================
// PUSH SUBSCRIPTION — یک ردیف به‌ازای هر مرورگر/دستگاهی که کاربر نوتیف
// واقعی (Web Push، حتی وقتی تب/اپ کاملاً بسته‌ست) رو فعال کرده. یک کاربر
// می‌تونه چند دستگاه/مرورگر ثبت‌شده داشته باشه، پس یک-به-چند با User ـه —
// نه یک فیلد تکی روش.
// ============================================================================

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint  String   @unique
  p256dh    String
  auth      String

  createdAt DateTime @default(now())

  @@index([userId])
}

model UserSetting {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String   // مثلاً "theme" | "removedOccurrences" | "customOccurrences"
  value     Json

  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId])
}

model ExportRequest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  format    String   // pdf | csv
  module    ModuleKey?
  fileUrl   String?
  status    String   @default("pending") // pending | ready | failed

  createdAt DateTime @default(now())
  completedAt DateTime?

  @@index([userId])
}

model SharedProgressLink {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  token      String   @unique // برای URL عمومی read-only
  module     ModuleKey?
  isActive   Boolean  @default(true)
  expiresAt  DateTime?

  createdAt  DateTime @default(now())

  @@index([userId])
}

// ============================================================================
// OWNER PANEL — Audit Log / Error Log / Analytics Events / App Settings
// ============================================================================
// این بخش صرفاً برای پنل Owner است. بدون رابطه‌ی مستقیم به User برای
// targetUserId (تا حذف یک کاربر لاگِ اقدامات روش رو پاک نکنه — تاریخچه‌ی
// مدیریتی باید حتی بعد از حذف کاربر باقی بمونه)، پس فقط رشته‌ی id خام ذخیره
// می‌شه، نه FK.

// هر اقدام مدیریتیِ Owner روی داده‌ی واقعی — نه یک لاگِ عمومیِ اپلیکیشن.
model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String   // owner ای که اقدام رو انجام داده
  action       String   // مثلاً "user.block" | "user.plan_change" | "setting.ai_cost_rate"
  targetType   String?  // مثلاً "User" | "Subscription" | "AppSetting"
  targetId     String?
  meta         Json?    // جزئیاتِ قبل/بعدِ تغییر — هیچ‌وقت رمز/توکن/کلید داخلش ذخیره نشه
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId, createdAt])
}

// رخدادهای خطای واقعیِ سیستم (نه Fake) — از جاهایی که واقعاً catch می‌شن
// نوشته می‌شه: گیت‌وی AI، اتصال دیتابیس، و مسیرهای بحرانیِ auth.
model ErrorLog {
  id         String        @id @default(cuid())
  service    String        // مثلاً "ai-gateway" | "auth" | "database" | "payment"
  severity   ErrorSeverity @default(ERROR)
  message    String
  // هیچ‌وقت secret/token/password/apiKey داخلِ context ذخیره نشه — فقط
  // اطلاعاتِ تشخیصیِ بی‌خطر (مثلاً feature/model/statusCode)
  context    Json?
  createdAt  DateTime      @default(now())

  @@index([createdAt])
  @@index([severity, createdAt])
}

// رویدادهای سبک برای تحلیل Funnel — فقط دو مرحله‌ای که جای دیگه‌ای قابل
// استخراج نیستن (بقیه‌ی مراحلِ Funnel از جداول موجود مثل User/Subscription/
// Payment مشتق می‌شن، نیازی به رویداد جداگانه ندارن)
model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?  // ممکنه مهمون باشه (هنوز ثبت‌نام نکرده)
  type      String   // "view_subscription_page" | "checkout_start"
  meta      Json?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([userId, type])
}

// تنظیمات سراسریِ اپ (نه به‌ازای کاربر) — فقط برای مواردی که Owner باید
// بتونه بدونِ دیپلوی تغییرشون بده. الگوی key/value مثلِ UserSetting.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
