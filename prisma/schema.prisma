// ============================================================================
// PRISMA SCHEMA — پلتفرم روتین/سلامت/ترید چندپلنی و دو-بازاری
// ============================================================================
// طراحی‌شده برای:
//  - دو بازار مستقل (ایران/تومان و بین‌المللی/دلار) زیر یک دیتابیس
//  - ۴ پلن قابل‌ترکیب (پایه، ورزش، ترید، مکس) بدون هاردکد کردن منطق دسترسی
//  - رفرال کاربر-به-کاربر + قرارداد باشگاه (٪سهم و ٪تخفیف)
//  - سقف مصرف ماهانه AI (Haiku برای ایران، Sonnet برای بین‌المللی)
//  - هر ماژول محصول (روتین، خواب، کار روزمره، ورزش، کالری، ترید، رودمپ) کاملا مجزا
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum Market {
  IRAN
  INTERNATIONAL
}

enum Currency {
  IRR
  USD
}

enum AiModel {
  HAIKU // بازار ایران — ارزون‌تر
  SONNET // بازار بین‌المللی
}

enum ModuleKey {
  ROUTINE // روتین/چک‌لیست روزانه — همیشه در پلن پایه
  SLEEP // خواب — همیشه در پلن پایه
  TASKS // کارهای روزمره — همیشه در پلن پایه
  EXERCISE // ورزش
  CALORIE // کالری
  TRADE // ژورنال ترید
  ROADMAP // رودمپ آموزشی — همراه با پلن مکس یا جدا، به‌صورت پیکربندی‌شده
  AI_INSIGHT // Correlation Insight — فقط پلن مکس
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum ReferralUsageStatus {
  PENDING // ثبت شده ولی هنوز شرط تکمیل (مثلا اولین پرداخت) برقرار نشده
  REWARDED // پاداش (ماه رایگان / سهم باشگاه) اعمال شده
  REVOKED // به هر دلیل باطل شده (مثلا استرداد وجه)
}

enum PartnerType {
  GYM
  OTHER
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

enum AiFeatureKey {
  DAILY_BRIEFING
  WEEKLY_COACH_REPORT
  CORRELATION_INSIGHT
  ROADMAP_GENERATION
  EXERCISE_PLAN_GENERATION
  // اسکن عکس غذا — قابلیت کلا حذف شد؛ فقط برای ردیف‌های مصرف قدیمی مونده
  FOOD_SCAN
  // دستیار «مدیر برنامه» روی صفحه‌ی روتین. شمارش همین ردیف‌هاست که سهمیه‌ی
  // پیام‌های رایگان (FREE_ASSISTANT_USES) را می‌سنجد، پس نباید بی‌جهت جای دیگری هم ثبت شود.
  ROUTINE_ASSISTANT
}

// سطح شدت یک رخداد خطای واقعی (نه ساختگی) که سیستم ثبت کرده
enum ErrorSeverity {
  WARNING
  ERROR
  CRITICAL
}

// ============================================================================
// USER & AUTH
// ============================================================================

model User {
  id           String    @id @default(cuid())
  email        String?   @unique
  phone        String?   @unique
  username     String?   @unique
  passwordHash String?
  name         String?
  lastName     String?
  avatarUrl    String?
  // بنر بالای پروفایل — مثل avatarUrl به‌شکل data URL ذخیره می‌شه (استوریج
  // ابری هنوز راه‌اندازی نشده) و سمت کلاینت قبل از ارسال فشرده می‌شه.
  bannerUrl    String?
  // بیوگرافی کوتاه پروفایل — هم توی پنل کاربری ویرایش می‌شه هم توی
  // پاپ‌آپ پروفایل دوستان دیده می‌شه.
  bio          String?
  birthDate    DateTime?
  gender       String? // "male" | "female" | null — اختیاری، فقط اگه کاربر خودش پر کنه
  // پروفایل — مستقل از اسنپ‌شات heightCm/weightKg خود ExercisePlan/CalorieTarget
  // (که لحظه‌ی محاسبه رو ثبت می‌کنن)؛ این‌جا مقدار فعلی کاربره که از پروفایل ویرایش می‌شه.
  heightCm     Int?
  weightKg     Float?

  // پنل کاربری › حریم خصوصی: خاموش‌کردنش یعنی توی جست‌وجوی دوستان (/api/friends/search) دیده نشه
  discoverable     Boolean @default(true)
  // پنل کاربری › حریم خصوصی: روشن‌کردنش یعنی شماره‌ی حساب توی پاپ‌آپ
  // پروفایل برای دوستان دیده بشه — پیش‌فرض خاموش، چون شماره حریم خصوصی
  // حساسی‌ست و نباید بدون اجازه‌ی صریح به اشتراک گذاشته بشه.
  sharePhone       Boolean @default(false)
  // ورود دومرحله‌ای با پیامک — با روشن‌بودنش، بعد از رمز درست یک کد
  // یک‌بارمصرف به شماره‌ی همین حساب می‌ره و بدون اون کد نشستی صادر نمی‌شه.
  // فقط وقتی می‌شه روشنش کرد که شماره‌ی تاییدشده روی حساب باشه.
  twoFactorEnabled Boolean @default(false)

  // سوپریوزر/ادمین — دسترسی نامحدود به همه ماژول‌ها بدون نیاز به اشتراک
  isSuperAdmin Boolean @default(false)

  // ادمین محدود — کلیدهای دسترسی پنل (lib/adminPermissions.ts). خالی یعنی
  // ادمین نیست؛ isSuperAdmin همیشه همه‌ی دسترسی‌ها رو داره و این آرایه براش
  // نادیده گرفته می‌شه. فقط سمت سرور از /api/admin/admins تغییر می‌کنه.
  adminPermissions String[] @default([])

  // بیشترین استریکی که این کاربر تا حالا داشته — برخلاف استریک فعلی (که
  // زنده از DailyEntry حساب می‌شود، lib/friendStats.ts)، این عدد باید جایی
  // ذخیره بماند وگرنه با شکستن استریک فعلی رکورد گذشته گم می‌شد. هر بار
  // پروفایل کاربر خوانده می‌شود، اگر استریک زنده از این عدد بیشتر بود،
  // همین‌جا lazily آپدیت می‌شود (lib/friendProfile.ts).
  bestStreak Int @default(0)

  // پنل Owner › کاربران › مسدودکردن — کاربر مسدودشده نمی‌تونه لاگین کنه
  // (چک در authorize())؛ soft-delete نیست، فقط جلوی ورود رو می‌گیره
  isBlocked Boolean   @default(false)
  blockedAt DateTime?

  // پنل Owner › تعدیل چت ترید — سه سطح مستقل که خود ادمین انتخاب می‌کنه
  // (نه escalation خودکار): اخطار (فقط نمایشی، پیام کاربر را نمی‌بندد)،
  // بن موقت ۷۲ساعته (chatBanUntil)، و غیرفعال‌سازی دائمی چت (chatDisabled).
  // هر سه فقط جلوی *فرستادن* پیام جدید را می‌گیرند، نه خواندن اتاق.
  chatBanUntil   DateTime?
  chatDisabled   Boolean   @default(false)
  chatWarnAt     DateTime? // آخرین اخطاری که ادمین صادر کرده
  chatWarnNote   String? // متن همان اخطار
  chatWarnSeenAt DateTime? // کاربر کی دیدتش — null یا قدیمی‌تر از chatWarnAt یعنی هنوز ندیده

  market   Market // بازار کاربر — تعیین‌کننده ارز/پلن/مدل AI/زبان پیش‌فرض
  locale   String @default("fa") // fa | en
  timezone String @default("Asia/Tehran")

  // «نام طلایی»: لحظه‌ای که همه‌ی اچیومنت‌های lib/achievements.ts باز شد (فقط
  // سمت سرور ست می‌شه — lib/achievementsServer.ts). null = هنوز نه.
  goldenSince DateTime?

  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete برای نگهداری تاریخچه مالی/رفرال

  // روابط احراز هویت
  accounts          OAuthAccount[]
  sessions          Session[]
  loginEvents       LoginEvent[]
  passwordResetOtps PasswordResetOtp[]
  twoFactorOtps     TwoFactorOtp[]

  // روابط تجاری
  subscriptions Subscription[]
  moduleAccess  ModuleAccess[]
  aiUsage       AiUsageRecord[]

  // رفرال — کد خود کاربر برای دعوت دیگران
  referralCode            ReferralCode?
  referralUsagesAsInvitee ReferralUsage[] @relation("InviteeUsages")

  // اگر کاربر از طریق باشگاه اومده
  gymPartnerId String?
  gymPartner   Partner? @relation("GymUsers", fields: [gymPartnerId], references: [id])

  // داده‌های ماژول‌ها
  dailyEntries        DailyEntry[]
  sleepEntries        SleepEntry[]
  achievements        UserAchievement[]
  tasks               Task[]
  exercisePlans       ExercisePlan[]
  exerciseLogs        ExerciseLog[]
  foodLogs            FoodLogEntry[]
  calorieTargets      CalorieTarget[]
  tradeEntries        TradeEntry[]
  tradeAccounts       TradeAccount[]
  tradeTags           TradeTag[]
  tradeChecklists     TradeChecklist[]
  roadmaps            Roadmap[]
  weeklyAnalysisAi    WeeklyAnalysisAi[]
  weeklyAnalysisGoals WeeklyAnalysisGoal[]
  weeklyReflections   WeeklyReflection[]

  userSettings      UserSetting[]
  exportRequests    ExportRequest[]
  sharedLinks       SharedProgressLink[]
  pushSubscriptions PushSubscription[]
  pushReminderLogs  PushReminderLog[]

  // دوستان — درخواست‌های فرستاده‌شده/دریافت‌شده (یک ردیف Friendship به‌ازای هر جفت)
  friendRequestsSent     Friendship[]       @relation("FriendRequestsSent")
  friendRequestsReceived Friendship[]       @relation("FriendRequestsReceived")
  // استارهایی که به دیگران داده/از دیگران گرفته — از favoritedBy* بالا جداست:
  // آن یکی شخصی و فقط برای پین‌کردن در لیست خود کاربر بود، این یکی عمومی و
  // متقابل نیست (هرکسی می‌تواند به هر دوستی استار بدهد، مستقل از این‌که خود
  // آن طرف هم استار داده باشد یا نه) — دقیقا همان چیزی که پروفایل دوست نشان می‌دهد.
  starsGiven             FriendStar[]       @relation("StarsGiven")
  starsReceived          FriendStar[]       @relation("StarsReceived")
  // بلاک کاربر-به-کاربر (نه isBlocked بالا که فقط ادمین از پنل می‌زند) —
  // کاربر بلاک‌شده دیگر در جست‌وجوی دوستان دیده نمی‌شود.
  blockedUsers           UserBlock[]        @relation("Blocker")
  blockedByUsers         UserBlock[]        @relation("Blocked")
  tradeNotes             TradeNote[]
  tradeMtLinks           TradeMtLink[]
  tradeChatMessages      TradeChatMessage[]
  tradeChatReports       TradeChatReport[]  @relation("ChatReporter")
  supportTickets         SupportTicket[]

  // اکوسیستم منتور — پروفایل منتوری (اختیاری؛ داشتنش یعنی کاربر منتور هم هست)
  mentorProfile                MentorProfile?
  mentorshipsAsMentor          Mentorship[]          @relation("MentorshipMentor")
  mentorshipsAsStudent         Mentorship[]          @relation("MentorshipStudent")
  mentorProgramsAsMentor       MentorProgram[]       @relation("MentorProgramMentor")
  mentorProgramsAsStudent      MentorProgram[]       @relation("MentorProgramStudent")
  mentorMessagesSent           MentorMessage[]
  mentorReviewsGiven           MentorReview[]        @relation("MentorReviewStudent")
  // صف انتظار منتور پر (مهاجرت 20260928140000_mentor_waitlist) — lib/mentorWaitlistServer.ts
  mentorWaitlistAsMentor       MentorWaitlistEntry[] @relation("MentorWaitlistMentor")
  mentorWaitlistAsStudent      MentorWaitlistEntry[] @relation("MentorWaitlistStudent")
  mentorReviewsReceived        MentorReview[]        @relation("MentorReviewMentor")
  mentorReportsFiled           MentorReport[]        @relation("MentorReportReporter")
  notifications                InAppNotification[]
  // کلیدهای عمومی رمزگذاری سرتاسری (مهاجرت 20260927163000_mentor_e2ee)
  e2eKeys                      UserE2EKey[]
  // رمزگذاری خودکار (مهاجرت 20260928102000_e2ee_auto): نمک کلید مشتق از رمز عبور و درخواست انتقال سابقه
  e2eKdf                       UserE2EKdf?
  e2eDeviceLinks               E2EDeviceLink[]
  // منتورهای ذخیره‌شده برای تصمیم بعدی (مهاجرت 20260928100000_saved_mentors)
  savedMentors                 SavedMentor[]         @relation("SavedMentorOwner")
  savedByUsers                 SavedMentor[]         @relation("SavedMentorTarget")
  // پذیرش «شرایط استفاده از بخش منتورها» به‌عنوان شاگرد (مهاجرت 20260928104000_mentor_terms_acceptance)
  // — lib/mentorTerms.ts. نسخه‌ی کهنه = پذیرش دوباره هنگام درخواست بعدی
  mentorStudentTermsAcceptedAt DateTime?
  mentorStudentTermsVersion    String?

  @@index([market])
  @@index([gymPartnerId])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // google | apple | ...
  providerAccountId String
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// نشست واقعی هر دستگاه. استراتژی next-auth همچنان JWTه، ولی هر توکن
// صادرشده یک `sid` یکتا داخلش داره که به یکی از همین ردیف‌ها اشاره می‌کنه —
// پس «دستگاه‌های فعال» و «بیرون‌انداختن نشست یک دستگاه دیگه» واقعا ممکنه:
// با پرشدن revokedAt، اولین درخواست بعدی اون توکن رد می‌شه.
model Session {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken String    @unique // همون sid داخل JWT
  provider     String? // credentials | google | email-otp | sms-2fa
  ip           String?
  userAgent    String?
  expiresAt    DateTime
  lastSeenAt   DateTime  @default(now())
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([userId, revokedAt])
}

// لاگ append-only هر ورود موفق — پنل کاربری › امنیت › «ورودهای اخیر».
// این پروژه از session استراتژی JWT استفاده می‌کنه (بدون ردیف سرور فعال به‌ازای
// هر توکن)، پس این جدول یک «سابقه‌ی ورود» واقعیه، نه یک لیست session قابل‌ابطال —
// چیزی که مدل Session بالا برای‌ش ساخته شده ولی الان استفاده نمی‌شه.
model LoginEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String // "credentials" | "google"
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// کد یک‌بارمصرف فراموشی رمز — پیامکی به شماره کاربر می‌ره. کد به‌صورت هش‌شده
// ذخیره می‌شه (نه متن خام)، محدود به چند تلاش (جلوگیری از حدس‌زدن brute-force
// روی یه کد ۵رقمی)، و بعد از انقضا/مصرف دیگه معتبر نیست.
model PasswordResetOtp {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// کد یک‌بارمصرف تایید شماره موبایل موقع ثبت‌نام — برخلاف PasswordResetOtp
// به یک User موجود وصل نیست (چون کاربر هنوز ساخته نشده)، فقط به خود شماره.
// verifiedAt یعنی کاربر کد رو درست وارد کرده؛ usedAt یعنی همون تاییدیه واقعا
// برای ساخت یک حساب مصرف شده (جلوگیری از استفاده‌ی دوباره‌ی یک تاییدیه‌ی
// قدیمی برای چند ثبت‌نام).
// کد یک‌بارمصرف ورود دومرحله‌ای — دقیقا هم‌الگوی PasswordResetOtp (هش‌شده،
// محدود چند تلاش، منقضی‌شونده). verifiedAt یعنی کد درست وارد شده و usedAt
// یعنی همون تاییدیه واقعا برای صدور نشست مصرف شده؛ همون جداسازی‌ای که
// EmailLoginOtp هم داره، تا یک تاییدیه دو بار نشست صادر نکنه.
model TwoFactorOtp {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  verifiedAt DateTime?
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model SignupOtp {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  verifiedAt DateTime?
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone])
}

// ورود بدون رمز با کد ایمیل — دقیقا همون الگوی SignupOtp (کلید رشته‌ی
// خام email، نه userId، چون در لحظه‌ی درخواست نباید فاش بشه که این ایمیل
// حساب کاربری داره یا نه — همون قرارداد ضدenumeration بقیه‌ی سایت).
// verifiedAt = کد درست وارد شده (مرحله‌ی پیش‌بررسی فرانت)؛ usedAt = واقعا
// برای صدور نشست مصرف شده (توسط authorize()ی provider «email-otp» توی
// lib/auth.ts). این جداسازی یعنی هیچ پیام سفارشی‌ای لازم نیست از دل
// authorize() NextAuth (که پیام‌های سفارشی رو نگه نمی‌داره) رد بشه.
model EmailLoginOtp {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  verifiedAt DateTime?
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
}

// تغییر ایمیل از پنل کاربری — برخلاف EmailLoginOtp (که به یک ایمیل خام
// وصله و برای ورود بدون‌رمزه)، این‌جا به یک userId لاگین‌شده وصله؛ کد به
// newEmail (ایمیل جدید، نه فعلی) فرستاده می‌شه تا مالکیت ایمیل جدید
// اثبات بشه — دقیقا همون دلیلی که تغییر مستقیم بدون تایید امن نبود.
model EmailChangeOtp {
  id        String    @id @default(cuid())
  userId    String
  newEmail  String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ============================================================================
// PLANS, PRICING & SUBSCRIPTIONS
// ============================================================================

// یک "Plan" فقط یک قالب تجاری/قیمتی‌ست. اینکه کدام ماژول‌ها را باز می‌کند
// در PlanModule تعریف می‌شود، نه هاردکد در کد — همین باعث می‌شود اگر بعدا
// پلن‌بندی عوض شد (مثلا ماژول جدید یا تغییر ترکیب)، فقط داده تغییر کند.
model Plan {
  id     String @id @default(cuid())
  key    String // "basic" | "exercise" | "trade" | "max"
  nameFa String
  nameEn String

  market   Market // هر پلن مخصوص یک بازار تعریف می‌شود (قیمت‌گذاری جدا)
  currency Currency

  priceMonthly Int // به کوچک‌ترین واحد ارز (ریال برای IRR، سنت برای USD) تا خطای اعشار نداشته باشیم
  priceYearly  Int?

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  modules       PlanModule[]
  subscriptions Subscription[]

  @@unique([key, market])
  @@index([market])
}

model PlanModule {
  id     String    @id @default(cuid())
  planId String
  plan   Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  module ModuleKey

  @@unique([planId, module])
}

model Subscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  status   SubscriptionStatus @default(TRIAL)
  interval BillingInterval    @default(MONTHLY)

  startDate        DateTime  @default(now())
  currentPeriodEnd DateTime
  canceledAt       DateTime?
  trialEndsAt      DateTime?

  // درصد تخفیف اعمال‌شده از قرارداد باشگاه یا کد تخفیف (مثلا ۱۰٪ = 10)
  discountPercent        Int            @default(0)
  appliedReferralUsageId String?
  appliedReferralUsage   ReferralUsage? @relation(fields: [appliedReferralUsageId], references: [id])

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model Payment {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  amount      Int // واحد کوچک ارز، بعد از اعمال تخفیف
  currency    Currency
  provider    String // zarinpal | stripe | ...
  providerRef String? // شناسه تراکنش سمت درگاه

  // برای محاسبه سهم باشگاه از سود واقعی، نه از قیمت لیست
  gymRevenueShareAmount Int? // مبلغی که باید به باشگاه پرداخت شود (۱۵٪ سهم)

  paidAt     DateTime?
  refundedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([subscriptionId])
}

// دسترسی محاسبه‌شده به هر ماژول — این جدول را یک job/webhook بعد از هر تغییر
// در Subscription دوباره می‌سازد. کد سمت اپ فقط همین جدول را چک می‌کند و
// هیچ‌وقت مستقیما به Plan/PlanModule وابسته نیست.
model ModuleAccess {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  module    ModuleKey
  active    Boolean   @default(false)
  expiresAt DateTime? // برای دسترسی موقت trial یا گریس‌پیریود بعد از لغو

  updatedAt DateTime @updatedAt

  @@unique([userId, module])
  @@index([userId])
}

// ============================================================================
// REFERRAL & GYM PARTNERSHIP
// ============================================================================

model ReferralCode {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String   @unique
  createdAt DateTime @default(now())

  usages ReferralUsage[] @relation("CodeUsages")
}

model ReferralUsage {
  id             String       @id @default(cuid())
  referralCodeId String
  referralCode   ReferralCode @relation("CodeUsages", fields: [referralCodeId], references: [id])

  inviteeUserId String
  inviteeUser   User   @relation("InviteeUsages", fields: [inviteeUserId], references: [id])

  status ReferralUsageStatus @default(PENDING)

  // status=REWARDED یعنی دعوت‌شونده خرید اولش رو با این کد کرد (10٪ گرفت)؛ از همون
  // لحظه صاحب کد یک بار 15٪ روی خرید بعدی خودش داره و inviterRewardApplied یعنی
  // اون پاداش مصرف شده (lib/referral.ts). inviteeRewardApplied فعلا استفاده نمی‌شه.
  inviterRewardApplied Boolean @default(false)
  inviteeRewardApplied Boolean @default(false)

  subscriptions Subscription[] // اشتراک‌هایی که این کد تخفیف را گرفتند

  createdAt  DateTime  @default(now())
  rewardedAt DateTime?
  revokedAt  DateTime?

  @@index([inviteeUserId])
  @@index([referralCodeId])
}

// کدهای تخفیف عمومی که سوپرادمین از پنل ادمین می‌سازه — جدا از ReferralCode
// (که شخصیه، هرکاربر یکی داره، برای دعوت دوستانه). این‌ها با دست ساخته
// می‌شن، می‌تونن منقضی بشن، و می‌تونن فقط روی یک پلن خاص اعمال بشن.
model DiscountCode {
  id             String              @id @default(cuid())
  code           String              @unique
  percentOff     Int
  // null یعنی روی همه‌ی پلن‌ها اعمال می‌شه؛ در غیر این صورت فقط همون کلید پلن
  // (مثلا "exercise") — همون Plan.key، نه یه رابطه‌ی FK، چون یک کلید توی هر
  // دو بازار (Market) به‌طور بالقوه پلن جدا داره و این کد فعلا فقط بازار
  // ایران رو پوشش می‌ده (همون محدودیت چک‌اوت فعلی).
  planKey        String?
  expiresAt      DateTime?
  active         Boolean             @default(true)
  // null یعنی هر کاربر بدون محدودیت می‌تونه این کد رو مصرف کنه؛ عدد مشخص
  // یعنی سقف تعداد دفعات مصرف این کد برای هر کاربر (رکوردش توی
  // DiscountCodeUsage، یکی به‌ازای هر خرید موفق verify-شده).
  maxUsesPerUser Int?
  createdAt      DateTime            @default(now())
  usages         DiscountCodeUsage[]

  @@index([code])
}

// یک ردیف به‌ازای هر مصرف موفق یک DiscountCode توسط یک کاربر — فقط موقع
// verify شدن واقعی پرداخت ثبت می‌شه (app/api/subscription/verify)، نه
// موقع پیش‌نمایش/اعمال توی چک‌اوت. شمارش همین ردیف‌ها برای هر
// (discountCodeId, userId) در برابر maxUsesPerUser چک می‌شه.
model DiscountCodeUsage {
  id             String       @id @default(cuid())
  discountCodeId String
  discountCode   DiscountCode @relation(fields: [discountCodeId], references: [id])
  userId         String
  usedAt         DateTime     @default(now())

  @@index([discountCodeId, userId])
}

// باشگاه یا هر شریک تجاری دیگر
model Partner {
  id           String      @id @default(cuid())
  type         PartnerType @default(GYM)
  name         String
  contactPhone String?
  contactEmail String?

  market Market

  revenueSharePercent Int @default(15) // سهم باشگاه از سود واقعی
  userDiscountPercent Int @default(10) // تخفیف به کاربرانی که از این باشگاه می‌آیند

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[] @relation("GymUsers")

  @@index([market])
}

// ============================================================================
// AI USAGE (Daily Briefing / Weekly Coach / Correlation Insight)
// ============================================================================

model AiUsageRecord {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  feature AiFeatureKey
  // نام واقعی مدل فراخوانی‌شده (مثلا "gpt-4o-mini") — enum قدیمی
  // AiModel (Haiku/Sonnet) مال زمانی بود که مستقیم به Anthropic وصل
  // بودیم؛ از وقتی همه از گیت‌وی آروان‌کلود با یک مدل ثابت رد می‌شن،
  // یک رشته‌ی خام دقیق‌تر و صادقانه‌تره تا یک enum که دیگه با واقعیت نمی‌خونه.
  model   String

  inputTokens   Int @default(0)
  outputTokens  Int @default(0)
  costUsdMicros Int @default(0) // هزینه‌ی تخمینی به میکرو-دلار (بر اساس نرخ قابل‌تنظیم AppSetting)

  success    Boolean @default(true) // false یعنی فراخوانی/تولید شکست خورد (برای نرخ خطا در پنل Owner)
  durationMs Int? // زمان واقعی پاسخ‌گیری گیت‌وی — برای بخش وضعیت سیستم

  // خروجی همیشه باید صراحتا "پیشنهاد" باشد؛ این پرچم برای ممیزی محتوای تولیدشده
  // (مثلا بررسی دستی نمونه‌ای که آیا زبان دستوری/توصیه پزشکی درش نشت کرده) نگه داشته می‌شود
  flaggedForReview Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, feature, createdAt])
  @@index([feature, createdAt])
}

// سقف مصرف ماهانه هر کاربر برای هر فیچر AI — جلوگیری از هزینه کنترل‌نشده
model AiMonthlyQuota {
  id         String       @id @default(cuid())
  userId     String
  feature    AiFeatureKey
  yearMonth  String // فرمت "2026-08" برای شمارش ساده بدون کوئری تاریخ پیچیده
  usedCount  Int          @default(0)
  limitCount Int // بر اساس پلن کاربر ست می‌شود

  @@unique([userId, feature, yearMonth])
}

// ============================================================================
// MODULE: ROUTINE / DAILY CHECKLIST (هسته پایه — مبتنی بر همان منطق فایل HTML فعلی)
// ============================================================================

model RoutineItem {
  id        String    @id @default(cuid())
  userId    String
  // آیتم‌های تعریف‌شده توسط کاربر یا سیستم (مثل ترید/فرانسه/OWASP در نسخه فعلی)
  name      String
  // زمان‌بندی هفتگی به‌صورت JSON: [{jsDay, startMin, endMin}], تا از منطق سخت‌کدشده HTML جدا شود
  schedule  Json
  startDate DateTime?
  endDate   DateTime?
  isActive  Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model DailyEntry {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date // یک رکورد به‌ازای هر کاربر/روز

  // وضعیت تیک هر RoutineItem در آن روز: { [routineItemId]: boolean }
  completedItems Json      @default("{}")
  wakeUpAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
}

// ============================================================================
// MODULE: FRIENDS (دوستان — مشاهده‌ی درصد پیشرفت روزانه‌ی هم)
// ============================================================================

// درخواست دوستی — requester تا وقتی addressee قبول نکنه PENDING می‌مونه.
// یکتا بر اساس جفت (requester, addressee) تا درخواست تکراری نره؛ دوستی
// دوطرفه یعنی یا این ردیف یا معکوسش با status=ACCEPTED وجود داره — کوئری‌ها
// همیشه هر دو جهت رو با OR چک می‌کنن (لیست دوستان/تشخیص already-friends).
model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  requester   User             @relation("FriendRequestsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User             @relation("FriendRequestsReceived", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(PENDING)

  // فیوریت‌بودن شخصیه، نه متقارن — رکورد Friendship یکی برای هر دو طرفه،
  // پس باید جدا نگه داریم که کدوم طرف این دوستی رو استار زده.
  favoritedByRequester Boolean @default(false)
  favoritedByAddressee Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requesterId, addresseeId])
  @@index([requesterId])
  @@index([addresseeId])
}

// استار دادن به یک کاربر — یک‌طرفه (نه توگل‌شونده‌ی متقابل مثل فیوریت
// بالا)؛ حذف/ایجاد همین ردیف یعنی استاردادن/برداشتن استار. تعداد
// starsReceived همان چیزی‌ست که پروفایل دوست نشان می‌دهد.
model FriendStar {
  id         String   @id @default(cuid())
  giverId    String
  giver      User     @relation("StarsGiven", fields: [giverId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("StarsReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([giverId, receiverId])
  @@index([receiverId])
}

// بلاک کاربر-به-کاربر — کاربر بلاک‌شده دیگر در جست‌وجوی دوستان
// (/api/friends/search) دیده نمی‌شود. مستقل از دوستی Friendship: بلاک
// می‌تواند قبل یا بعد از دوست‌شدن اتفاق بیفتد.
model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// ============================================================================
// MODULE: SLEEP
// ============================================================================

model SleepEntry {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date

  sleptAt       DateTime?
  wokeAt        DateTime?
  targetSleptAt DateTime? // هدف تعیین‌شده کاربر
  targetWokeAt  DateTime?

  quality Int? // ۱ تا ۵، اختیاری، خودارزیابی کاربر
  note    String? // یادداشت کوتاه اختیاری (خواب دیدم، بی‌خوابی، …)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
}

// اچیومنت‌های دائمی (کاتالوگ در lib/achievements.ts). یک بار که باز شد دیگه
// قفل نمی‌شه — حتی اگه متریکش بعدا پایین بیاد (مثلا حذف برنامه‌ها).
model UserAchievement {
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  unlockedAt    DateTime @default(now())

  @@id([userId, achievementId])
  @@index([userId])
}

// ============================================================================
// MODULE: TASKS (کارهای روزمره)
// ============================================================================

model Task {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  notes       String?
  dueDate     DateTime?
  priority    Int       @default(0)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, dueDate])
}

// ============================================================================
// MODULE: EXERCISE (سطوح مبتدی/متوسط/پیشرفته)
// ============================================================================

model ExercisePlan {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  level                 String // beginner | intermediate | advanced
  heightCm              Int?
  weightKg              Float?
  goal                  String? // مثلا "کاهش وزن" | "افزایش قدرت"
  hasPhysicalLimitation Boolean   @default(false) // چک‌باکس کلی، بدون جزئیات پزشکی
  disclaimerAcceptedAt  DateTime? // تیک تایید اجباری قبل از فعال‌سازی ماژول

  gymDays       Json? // آرایه‌ای از نام فارسی روزهای هفته که کاربر باشگاه می‌ره، مثلا ["شنبه","دوشنبه","چهارشنبه"]
  trainingPhase String? // bulk | cut | maintenance | none
  trainingMonth Int? // چندمین ماه تمرین کاربره — برای پیش‌روی منطقی (progressive overload) به AI داده می‌شه
  equipment     String? // تجهیزات در دسترس کاربر، متن آزاد — مثلا "باشگاه کامل" یا "فقط دمبل خونگی"
  generatedByAi Boolean @default(false) // false یعنی از قالب ایستای lib/exercisePlans.ts ساخته شده (fallback بدون کلید API)

  startDate DateTime @default(now())
  isActive  Boolean  @default(true)

  // ساختار برنامه هفتگی/ماهانه به‌صورت JSON — یا از هوش مصنوعی، یا (fallback) از قالب ایستای از‌پیش‌طراحی‌شده
  planData Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs ExerciseLog[]

  @@index([userId])
}

model ExerciseLog {
  id     String        @id @default(cuid())
  userId String
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId String?
  plan   ExercisePlan? @relation(fields: [planId], references: [id])

  date           DateTime  @db.Date
  completed      Boolean   @default(false)
  // اسم حرکت‌هایی که حین همین جلسه تیک خوردن — برای نمایش ضربدر حرکات
  // تیک‌نخورده بعد «پایان تمرین» و محاسبه‌ی درصد پیشرفت امروز.
  completedItems Json?
  // لحظه‌ی اولین «شروع تمرین» برای همین روز. حالت «ماندن» (lib/exerciseProgression.ts)
  // فقط روزی را «گذرانده» حساب می‌کند که شروع خورده باشد.
  startedAt      DateTime?
  notes          String?

  createdAt DateTime @default(now())

  @@unique([userId, planId, date])
  @@index([userId])
}

// عکس حرکات کاتالوگ (lib/exerciseCatalog.ts). خود کاتالوگ یک فایل ثابت
// کد است و عمدا همان‌طور می‌ماند؛ فقط عکس — که دستی و به‌مرور توسط ادمین
// اضافه می‌شود — دیتابیسی‌ست. کلید اتصال، *نام نرمال‌شده*ی حرکت است
// (normalizeFa: ی/ک عربی و نیم‌فاصله یک‌دست می‌شوند) نه نام خام، وگرنه یک
// «ي» عربی در ورودی ادمین یعنی عکسی که هیچ‌وقت پیدا نمی‌شود.
//
// مثل آواتار، عکس به‌شکل data URL ذخیره می‌شود چون هنوز هیچ استوریج
// فایلی در این پروژه نیست؛ سمت کلاینت قبل ارسال با canvas فشرده می‌شود.
model ExerciseMedia {
  id String @id @default(cuid())

  nameKey String @unique // normalizeFa(name) — کلید تطبیق با کاتالوگ
  name    String // نام نمایشی همان‌طور که ادمین انتخاب کرده
  dataUrl String // data:image/...;base64,...

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================================
// MODULE: CALORIE (سخت‌ترین از نظر داده — نیاز دیتابیس غذایی)
// ============================================================================

model FoodItem {
  id              String  @id @default(cuid())
  nameFa          String
  nameEn          String?
  caloriesPer100g Float
  proteinPer100g  Float?
  carbsPer100g    Float?
  fatPer100g      Float?

  // منبع داده (برای رفع اختلاف/آپدیت بعدی)
  source     String? // "internal" | "usda" | "user-submitted"
  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs FoodLogEntry[]

  @@index([nameFa])
}

model FoodLogEntry {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodItemId String?
  foodItem   FoodItem? @relation(fields: [foodItemId], references: [id])

  // برای غذاهای سفارشی/دستی که در دیتابیس نیستند
  customName     String?
  customCalories Float?

  date     DateTime @db.Date
  grams    Float
  mealType String? // breakfast | lunch | dinner | snack

  // درشت‌مغذی‌ها — اختیاری، از فرم افزودن غذا (هر سه با هم یا هیچ‌کدوم).
  // aiScanned فقط برای ثبت‌های قدیمی اسکن عکس غذا مونده؛ اون قابلیت کلا حذف شد
  // و دیگه هیچ ثبت تازه‌ای true نمی‌گیره.
  proteinG  Float?
  carbsG    Float?
  fatG      Float?
  aiScanned Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, date])
}

model CalorieTarget {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  dailyTargetKcal Int
  goal            String? // lose | maintain | gain
  mealsPerDay     Int?
  mealBreakdown   Json? // [{ key, label, kcal }] — جمعش باید با dailyTargetKcal برابر باشه

  // هدف درشت‌مغذی‌ها (گرم در روز) — اختیاری، فقط از مسیر «وارد کردن دستی»
  // پر می‌شه. نال یعنی کاربر هدفی تعیین نکرده و کارت درشت‌مغذی‌ها فقط
  // مصرف خام رو نشون می‌ده (رفتار قبلی).
  proteinTargetG Int?
  carbsTargetG   Int?
  fatTargetG     Int?
  sex            String? // male | female — فقط برای محاسبه BMR، جای دیگه‌ای ذخیره نمی‌شه
  ageYears       Int? // اگه User.birthDate نبود، همینجا مستقیم پرسیده و ذخیره می‌شه
  heightCm       Int? // اسنپ‌شات قد/وزن لحظه‌ی محاسبه (مثل ExercisePlan)، برای محاسبه BMR
  weightKg       Float?

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
}

// ============================================================================
// MODULE: TRADE (حساب معاملاتی › معامله › چک‌لیست/دلایل/احساسات › آمار)
//
// طراحی این بخش عمدا «حساب-محور»ه نه «کاربر-محور»: یک کاربر ده‌ها حساب
// معاملاتی داره (ریل/دمو/پراپ/بک‌تست) و هر آمار و هر معامله زیر یکی از
// اون‌هاست. سه قانونی که موقع خوندن این مدل‌ها باید در ذهن باشه:
//
//   ۱) هیچ داده‌ای پاک نمی‌شه که تاریخچه رو خراب کنه — حذف حساب یعنی
//      archived=true (معاملاتش سر جاشون می‌مونن و فقط از آمار کلی خارج می‌شن).
//   ۲) هرچیزی که بعدا ممکنه عوض بشه ولی آمار گذشته بهش تکیه داره
//      (متن آیتم‌های چک‌لیست)، در لحظه‌ی ثبت معامله snapshot می‌شه، نه
//      فقط ارجاع ID — وگرنه ویرایش یک چک‌لیست، آمار صدتا معامله‌ی قبلی رو
//      بی‌صدا عوض می‌کنه.
//   ۳) زمان‌ها همیشه UTCن. ساعت محلی کاربر (User.timezone) فقط لایه‌ی
//      نمایشه. جلسه‌ی معاملاتی (لندن/نیویورک/…) سمت سرور از روی همین
//      زمان UTC با DST واقعی هر شهر حساب می‌شه، نه با عدد ثابت.
// ============================================================================

enum TradeAccountType {
  REAL // حساب واقعی
  DEMO // دمو
  PROP // پراپ‌فرم
  BACKTEST // بک‌تست
}

// هدف سود حساب می‌تونه مبلغ باشه یا درصدی از بالانس اولیه
enum TradeGoalType {
  AMOUNT
  PERCENT
}

enum TradeDirection {
  BUY
  SELL
}

enum TradeStatus {
  OPEN // هنوز باز — قیمت/زمان خروج نداره
  CLOSED // بسته‌شده
  CANCELED // ستاپ باطل شد و اصلا وارد نشدیم (برای آمار «چندبار پلن رو نشکستم»)
}

enum TradeResult {
  PROFIT
  LOSS
  BREAKEVEN
}

// جلسه‌ی معاملاتی — آرایه‌ست نه تک‌مقدار، چون بازه‌های همپوشان واقعی‌ان
// (۱۳:۰۰–۱۶:۳۰ UTC هم لندنه هم نیویورک) و آمار «عملکردم در لندن» باید
// معاملات همپوشان رو هم بشمره.
enum TradeSession {
  SYDNEY
  TOKYO
  LONDON
  NEWYORK
}

// انگیزه‌ی ورود — چندانتخابی. ارزش واقعی این فیلد در آماره: مقایسه‌ی
// نرخ برد «طبق استراتژی» با «FOMO»/«انتقام از بازار» دقیقا همون چیزیه که
// اسپک محصول ازش با «چطور معامله می‌کنی؟» یاد می‌کنه.
enum TradeEntryReason {
  STRATEGY // طبق استراتژی
  TECHNICAL_SIGNAL // سیگنال تکنیکال
  FUNDAMENTAL_SIGNAL // سیگنال فاندامنتال
  NEWS // اخبار
  INTUITION // شهود
  OTHERS_ADVICE // توصیه دیگران
  FOMO
  REVENGE // انتقام از بازار
  OTHER
}

enum TradeExitReason {
  TAKE_PROFIT
  STOP_LOSS
  MANUAL // خروج دستی
  TRAILING_STOP
  MARKET_CHANGE // تغییر شرایط بازار
  EMOTIONAL // خروج احساسی
  TIME_BASED // خروج زمانی (پایان سشن/قبل خبر)
  OTHER
}

enum TradeEmotionBefore {
  CALM // آرام
  NEUTRAL // معمولی
  EXCITED // هیجان‌زده
  ANXIOUS // مضطرب
  ANGRY // عصبانی
  OVERCONFIDENT // بیش‌ازحد مطمئن
}

enum TradeEmotionAfter {
  SATISFIED // راضی
  RELIEVED // آسوده
  INDIFFERENT // بی‌تفاوت
  ANXIOUS // مضطرب
  REGRET // پشیمان
  ANGRY // عصبانی
}

// یک حساب معاملاتی. اتصال متاتریدر (فاز بعد) هم عمدا همین‌جا — روی خود
// حساب — می‌شینه نه روی کاربر، چون هر کاربر ده‌ها حساب داره و هر حساب
// اتصال مستقل خودش رو داره.
model TradeAccount {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name           String
  broker         String?
  type           TradeAccountType @default(REAL)
  currency       String           @default("USD") // ارز حساب — همه‌ی مبالغ معاملاتش به همینه
  initialBalance Float            @default(0)
  leverage       Int?
  color          String           @default("#00A86B")
  note           String?

  // هدف سود ماهانه‌ی همین حساب (قبلا یک عدد کلی بی‌واحد در تنظیمات کاربر بود)
  goalType  TradeGoalType @default(AMOUNT)
  goalValue Float         @default(0)

  // «حذف» در UI یعنی این — تاریخچه دست‌نخورده می‌مونه ولی از آمار کلی خارج می‌شه
  archived   Boolean   @default(false)
  archivedAt DateTime?

  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries TradeEntry[]
  notes   TradeNote[]
  tags    TradeTag[]   @relation("TradeAccountTags")
  mtLink  TradeMtLink?

  @@index([userId, archived])
}

// برچسب رنگی کاربرساخته — هم روی حساب استفاده می‌شه هم روی معامله، چون
// از نظر کاربر «برچسب» یک مفهومه و دو تا لیست جدا گیج‌کننده‌ست.
model TradeTag {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("#3E7BFA")
  createdAt DateTime @default(now())

  accounts TradeAccount[] @relation("TradeAccountTags")
  entries  TradeEntry[]   @relation("TradeEntryTags")
  notes    TradeNote[]    @relation("TradeNoteTags")

  @@unique([userId, name])
  @@index([userId])
}

// چک‌لیست پیش از معامله. برخلاف نسخه‌ی قبلی (یک لیست تخت واحد برای هر
// کاربر)، حالا کاربر چند چک‌لیست نام‌دار داره — «London Breakout»، «اسکالپ
// طلا» و… — و هر معامله به یکی‌شون وصل می‌شه.
model TradeChecklist {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  color     String   @default("#3E7BFA")
  // «الزام تکمیل چک‌لیست» — فقط هشدار می‌ده و معامله رو «خارج از پلن» علامت
  // می‌زنه؛ هیچ‌وقت جلوی ثبت معامله رو نمی‌گیره (اصل صریح محصول: Arion
  // نباید مانع ثبت واقعیت یک معامله بشه).
  required  Boolean  @default(false)
  archived  Boolean  @default(false)
  order     Int      @default(0)
  // نکات آزاد همین چک‌لیست — چیزهایی که مورد تیک‌خور نیستن ولی موقع اجرای
  // ستاپ باید جلوی چشم باشن (شرایط بازار، ساعت مجاز، ...).
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items   TradeChecklistItem[]
  entries TradeEntry[]

  @@index([userId, archived])
}

model TradeChecklistItem {
  id          String         @id @default(cuid())
  checklistId String
  checklist   TradeChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  text        String
  order       Int
  // آیا کاربر همین الان روی صفحه‌ی چک‌لیست تیکش زده — طبق درخواست صریح
  // («چک‌لیستم ذخیره نمیشه») این باید واقعا persist شود، نه فقط یک
  // useState محلی که با رفرش/خروج از صفحه گم می‌شود. جدا از
  // TradeEntry.checklistState (که یک اسنپ‌شات ثابت لحظه‌ی ثبت معامله‌ست،
  // هیچ‌وقت دستکاری نمی‌شود) — این فیلد وضعیت زنده‌ی «اجرای فعلی» همین
  // چک‌لیست است. ویرایش آیتم‌های چک‌لیست (نام/ترتیب) همچنان همه‌ی ردیف‌ها
  // را حذف/دوباره می‌سازد (app/api/trade/checklists/route.ts PATCH)، پس
  // این تیک‌ها را هم آن‌موقع پاک می‌کند — که پذیرفتنی است (ویرایش تعریف
  // چک‌لیست، طبیعتا یعنی از نو).
  checked     Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([checklistId])
}

model TradeEntry {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId String
  account   TradeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // ── اطلاعات ضروری ──────────────────────────────────────────────────────
  symbol     String // "EURUSD" — نامش از pair عوض شد چون سهام/کریپتو هم هست
  direction  TradeDirection
  timeframe  String? // "1h"، "15m"، … — از لیست ثابت lib/tradeSymbols
  openedAt   DateTime // زمان ورود، UTC — پایه‌ی آمار جلسه/روز/ساعت
  volume     Float // حجم
  volumeUnit String         @default("LOT") // LOT | USD — «(lot or usd)»ی فرم
  result     TradeResult
  // سود/زیان **خالص و علامت‌دار** به ارز حساب. کاربر عدد مثبت وارد می‌کنه و
  // علامت از result میاد. عمدا یک ستونه (نه ناخالص+خالص جدا) تا هیچ‌وقت دو
  // منبع حقیقت برای «سود» وجود نداشته باشه؛ کمیسیون/سواپ فقط اطلاعاتی‌ان و
  // در *پیشنهاد* محاسبه‌شده لحاظ می‌شن، نه اینکه دوباره از این کم بشن.
  pnl        Float          @default(0)
  riskFree   Boolean        @default(false) // معامله ریسک‌فری/بریک‌ایون شد؟
  status     TradeStatus    @default(CLOSED)

  // ── اطلاعات اختیاری ────────────────────────────────────────────────────
  entryPrice Float?
  exitPrice  Float?
  stopLoss   Float?
  takeProfit Float?
  closedAt   DateTime?
  commission Float?
  swap       Float?
  // ریسک اولیه به ارز حساب — مخرج R. یا کاربر مستقیم وارد می‌کنه، یا از
  // فاصله‌ی ورود تا حدضرر و اندازه‌ی قرارداد نماد پیشنهاد می‌شه.
  riskAmount Float?
  // R = pnl ÷ riskAmount — ذخیره می‌شه (نه فقط محاسبه‌ی لحظه‌ای) چون آمار
  // «میانگین R» باید سمت دیتابیس aggregate بشه، نه با کشیدن همه‌ی ردیف‌ها.
  rMultiple  Float?
  sessions   TradeSession[]
  setup      String? // ستاپ/استراتژی — همون strategy قبلی

  // ── دلایل و یادداشت ────────────────────────────────────────────────────
  entryReasons    TradeEntryReason[]
  exitReasons     TradeExitReason[]
  entryReasonNote String?
  exitReasonNote  String?
  note            String? // «نکات معامله»

  // ── احساسات ────────────────────────────────────────────────────────────
  emotionBefore TradeEmotionBefore?
  emotionAfter  TradeEmotionAfter?
  confidence    Int? // ۱ تا ۱۰
  followedPlan  Boolean? // طبق پلن عمل کردم؟

  // ── چک‌لیست (ارجاع + snapshot لحظه‌ی ثبت) ─────────────────────────────
  // checklistId فقط برای فیلتر «معاملات این چک‌لیست»ه و با حذف چک‌لیست
  // null می‌شه؛ چیزی که آمار واقعا بهش تکیه می‌کنه اسنپ‌شات زیرشه.
  checklistId       String?
  checklist         TradeChecklist? @relation(fields: [checklistId], references: [id], onDelete: SetNull)
  checklistName     String?
  checklistDone     Int?
  checklistTotal    Int?
  checklistSnapshot Json? // [{ text, checked }] — متن همون لحظه، نه متن امروز

  images TradeImage[]
  tags   TradeTag[]   @relation("TradeEntryTags")

  notes TradeNote[]

  // معامله‌ای که از متاتریدر همگام شده. externalId همان شناسه‌ی یکتای خود
  // ترمینال است (در MT4 شماره‌ی تیکت، در MT5 شناسه‌ی پوزیشن)، و کلید یکتای
  // (accountId, externalId) تضمین می‌کند اجرای دوباره‌ی sync — که در EA
  // کاملا عادی است — هیچ‌وقت معامله‌ی تکراری نسازد.
  externalId     String?
  externalSource String?
  // کاربر یک‌بار جزئیات این معامله‌ی همگام‌شده را دستی ویرایش کرده — از این به
  // بعد sync دیگر فیلدهای اصلی‌اش را (symbol/pnl/قیمت‌ها/...) بازنویسی نمی‌کند.
  syncLocked     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, externalId])
  @@index([userId, openedAt])
  @@index([accountId, openedAt])
  @@index([checklistId])
}

// عکس چارت — عمدا جدول جدا، نه ستونی روی خود TradeEntry. دلیل فنی:
// عکس به‌صورت data URL ذخیره می‌شه (استوریج فایل جدا نداریم) و اگه روی
// همون ردیف بود، هر کوئری لیست معاملات چند مگابایت عکس رو هم می‌کشید.
// این‌طوری ردیف معامله سبک می‌مونه و عکس فقط موقع بازکردن جزئیات لود می‌شه.
model TradeImage {
  id        String     @id @default(cuid())
  entryId   String
  entry     TradeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  dataUrl   String
  caption   String?
  order     Int        @default(0)
  createdAt DateTime   @default(now())

  @@index([entryId])
}

// ============================================================================
// MODULE: TRADE — اتصال متاتریدر
//
// اتصال عمدا روی **خود حساب** می‌نشیند نه روی کاربر: هر کاربر ده‌ها حساب
// معاملاتی دارد و هرکدام ترمینال/لاگین خودش را دارد؛ یک اتصال سراسری
// معنی نداشت.
//
// قواعد امنیتی که این مدل بر اساسشان ساخته شده و نباید شکسته شوند:
//   • رمز حساب معاملاتی هیچ‌جا ذخیره نمی‌شود و اصلا از کاربر خواسته
//     نمی‌شود. EA فقط داده می‌فرستد؛ ارتباط یک‌طرفه و خواندنی است.
//   • نه کد اتصال و نه توکن دائمی به‌صورت خام ذخیره نمی‌شوند — فقط
//     SHA-256شان. چون هر دو رشته‌ی تصادفی پرآنتروپی‌اند (نه رمز انتخابی
//     انسان)، هش سریع درست است و برخلاف bcrypt اجازه‌ی جست‌وجوی مستقیم
//     با ایندکس را هم می‌دهد.
//   • کد اتصال یک‌بارمصرف و کوتاه‌عمر است؛ توکن هر لحظه قابل ابطال.
// ============================================================================

enum MtPlatform {
  MT4
  MT5
}

model TradeMtLink {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // یک اتصال فعال به‌ازای هر حساب
  accountId String       @unique
  account   TradeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  platform MtPlatform

  // کد اتصال یک‌بارمصرف (فقط هش)
  pairingHash      String?   @unique
  pairingExpiresAt DateTime?

  // توکن دائمی EA (فقط هش). پیشوند صرفا برای نمایش «کدام توکن» در UI است.
  tokenHash   String? @unique
  tokenPrefix String?

  // چیزی که خود EA گزارش می‌کند
  brokerName   String?
  serverName   String?
  accountLogin String?
  balance      Float?
  equity       Float?
  currency     String?

  connectedAt DateTime?
  lastSyncAt  DateTime?
  revokedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ============================================================================
// MODULE: TRADE — یادداشت‌ها
//
// عمدا یک مدل سبک مستقل، نه یک ویرایشگر بلاکی تودرتو: نیاز این‌جا
// «یادداشت کوتاه با برچسب و رنگ و جست‌وجو»ست. یادداشت می‌تواند اختیارا
// به یک حساب یا یک معامله وصل شود تا
// «تحلیلی که آن روز نوشتم» کنار همان معامله پیدا شود.
// ============================================================================

model TradeNote {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title   String
  content String  @default("")
  color   String  @default("#3E7BFA")
  pinned  Boolean @default(false)

  // اتصال اختیاری — با حذف حساب/معامله فقط این ارجاع null می‌شود، خود
  // یادداشت می‌ماند (متنش مستقل از آن‌ها ارزش دارد).
  accountId String?
  account   TradeAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  entryId   String?
  entry     TradeEntry?   @relation(fields: [entryId], references: [id], onDelete: SetNull)

  tags TradeTag[] @relation("TradeNoteTags")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
  @@index([accountId])
  @@index([entryId])
}

// ============================================================================
// MODULE: TRADE — تقویم اقتصادی
//
// رویدادهای اقتصادی همیشه از جدول خودمان خوانده می‌شوند، نه مستقیم از یک
// سرویس بیرونی. دو دلیل عملی:
//   ۱) CSP اپ اجازه‌ی تماس مستقیم مرورگر با هاست خارجی را نمی‌دهد، پس
//      هر منبعی هم که بیاید باید از سمت سرور کش شود.
//   ۲) این ماژول نباید به در دسترس بودن یک سرویس خارجی گره بخورد — با
//      ورود دستی ادمین هم کاملا کار می‌کند (`source = MANUAL`).
// وقتی یک فید واقعی تنظیم شود، همان ردیف‌ها با `source` و `externalId`
// پر می‌شوند و کلید یکتا جلوی تکراری‌شدن را می‌گیرد.
// ============================================================================

enum EconomicImpact {
  LOW
  MEDIUM
  HIGH
}

model EconomicEvent {
  id String @id @default(cuid())

  // منبع و شناسه‌ی همان منبع — برای sync بدون ساختن رکورد تکراری
  source     String  @default("MANUAL")
  externalId String?

  title    String
  country  String // کد دوحرفی کشور، مثلا "US"
  currency String // "USD"
  impact   EconomicImpact
  occursAt DateTime // UTC — نمایش به وقت محلی کاربر انجام می‌شود

  // این سه عمدا رشته‌اند نه عدد: مقادیر واقعی تقویم واحد دارند
  // ("3.2%"، "215K"، "-1.4M") و تبدیلشان به عدد یعنی از دست دادن واحد.
  actual   String?
  forecast String?
  previous String?

  // توضیح کوتاه رویداد («بخش دیتیل») — فقط ورود دستی ادمین؛ فید
  // بیرونی همچین فیلدی نمی‌دهد، پس همیشه می‌تواند خالی باشد و کلاینت باید
  // برای این حالت یک متن جایگزین نشان بدهد، نه چیزی فبریکیت‌شده.
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, externalId])
  @@index([occursAt])
  @@index([currency, occursAt])
}

// ============================================================================
// MODULE: ROADMAP (رودمپ‌ساز — کاربر موضوع می‌دهد، سیستم/AI رودمپ می‌سازد)
// ============================================================================

model Roadmap {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // فقط همین دو چیز از کاربر پرسیده می‌شود؛ بقیه‌ی مسیر را مدل می‌سازد.
  topic String // «امنیت شبکه»، «ادیت ویدیو»، «گیتار»
  goal  String? // «می‌خواهم استخدام شوم» — مسیر را از ریشه عوض می‌کند

  title   String
  summary String? // یک پاراگراف: این مسیر چیست و آخرش کجاست

  // متن کامل مسیر — چه چیزهایی بخوان، با چه ترتیبی، چرا، با چه ابزارهایی،
  // کجا وقت تلف نکن. عمدا یک ستون متن بلند است و نه JSON: این متن برای
  // *خوانده‌شدن* است، نه برای map‌زدن UI.
  guide String? @db.Text

  // همان مسیر، بریده به ۳ تا ۱۶ مرحله با جزئیات ریز (lib/roadmapPlan.ts → PlanStage):
  // [{ n, title, goal, duration, focus, why, detailed, topics[], tasks[], project, tools[], resources[], pitfalls[], done[] }]
  steps Json?

  totalDuration String? // برآورد کل مسیر، مثلا «۶ ماه»
  tools         Json? // ابزارهای کل مسیر: {name, use}[] (ردیف‌های قدیمی: string[])

  // سطح/وقت هفتگی/پیش‌زمینه‌ی کاربر + برداشت مدل (مخاطب، پیش‌نیازها،
  // خروجی‌های نهایی، مدرک‌ها) — lib/roadmapPlan.ts → PlanMeta
  meta Json?

  // کدام مرحله‌ها تیک خورده‌اند: { "1": true, "3": true } — کلید شماره‌ی
  // مرحله است نه اندیس آرایه، چون شماره همان چیزی‌ست که به کاربر نشان
  // داده می‌شود. درصد همیشه سمت سرور از روی همین حساب می‌شود.
  progress Json?

  generatedByAi Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ============================================================================
// MODULE: WEEKLY ANALYSIS (آنالیز هفتگی — ماژول AI_INSIGHT) — جایگزین
// «گزارش هفتگی» قدیمی (WeeklyReportSnapshot/WeeklyGoal، حذف شد). محاسبه‌ی
// خود آنالیز (امتیازها/روند/بینش) دیگه snapshot نمی‌شه و همیشه زنده از
// lib/weeklyAnalysis/compute.ts محاسبه می‌شه؛ فقط سه چیز واقعا نیاز به
// ذخیره‌سازی دارن: خروجی AI (که هزینه/زمان داره)، اهداف هفتگی کاربر، و
// ریفلکشن متنی خود کاربر. قرارداد کامل: lib/weeklyAnalysis/types.ts.
// ============================================================================

// خروجی کش‌شده‌ی مربی AI برای یک هفته‌ی مشخص — idempotent با @@unique زیر
// (درخواست دوباره‌ی همون هفته باید همون ردیف رو بازسازی/آپدیت کنه، نه
// ردیف تکراری بسازه).
model WeeklyAnalysisAi {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart DateTime @db.Date // شنبه، به‌وقت محلی کاربر

  data  Json // شیء AiCoach کامل (summary/recommendations/generatedAt/model)
  model String // نام دقیق مدل فراخوانی‌شده — برای ممیزی/هزینه

  createdAt DateTime @default(now())

  @@unique([userId, weekStart])
}

// هدف هفتگی کاربر — همیشه برای هفته‌ی *بعد* هفته‌ی جاری ساخته می‌شه.
// وضعیتش وقتی اون هفته کامل تموم شد، lazily توسط service.ts محاسبه/قفل
// می‌شه (DONE اگه امتیاز دامنه به target رسیده باشه، وگرنه MISSED).
model WeeklyAnalysisGoal {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart     DateTime  @db.Date // هفته‌ای که هدف *برای* اونه
  domain        String?
  title         String
  target        Int? // امتیاز هدف دامنه (۰..۱۰۰)؛ null یعنی هدف متنی/دستی بدون سنجش خودکار
  status        String // ACTIVE | DONE | MISSED
  achievedScore Int? // امتیاز واقعی همون دامنه وقتی هفته تموم شد
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?

  @@index([userId, weekStart])
}

// ریفلکشن متنی هفتگی کاربر (چی خوب پیش رفت/چی باید بهتر بشه/حال‌وهوا) —
// یک ردیف به‌ازای هر (کاربر، هفته)، با ویرایش مجدد (upsert).
model WeeklyReflection {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart DateTime @db.Date

  wentWell String
  improve  String
  mood     Int? // ۱..۵

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, weekStart])
}

// ============================================================================
// USER SETTINGS (key-value ساده برای بلاب‌های کوچک JSON — تم، occurrenceهای
// حذف/اضافه‌شده‌ی برنامه هفتگی و مواردی از این دست که مدل اختصاصی نمی‌خوان)
// ============================================================================

// ============================================================================
// PUSH SUBSCRIPTION — یک ردیف به‌ازای هر مرورگر/دستگاهی که کاربر نوتیف
// واقعی (Web Push، حتی وقتی تب/اپ کاملا بسته‌ست) رو فعال کرده. یک کاربر
// می‌تونه چند دستگاه/مرورگر ثبت‌شده داشته باشه، پس یک-به-چند با User ـه —
// نه یک فیلد تکی روش.
// ============================================================================

model PushSubscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint String @unique
  p256dh   String
  auth     String

  createdAt DateTime @default(now())

  @@index([userId])
}

// رد «این یادآوری فرستاده شد» — یک ردیف به‌ازای هر (کاربر، یادآوری). کلید
// یکتای (userId, key) خودش قفل ضدتکراره: زمان‌بند داخلی (lib/pushScheduler.ts)
// توی هر worker cluster.js جدا اجرا می‌شه و بعد از هر ری‌استارت هم از نو، پس
// «ادعا» (INSERT) قبل از ارسال اتمیکه و فقط یکی برنده می‌شه. deadline همون
// لحظه‌ی شروع برنامه/رویداده؛ ردیف‌های خیلی قدیمی‌تر از اون جارو می‌شن.
model PushReminderLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  key      String
  deadline DateTime

  createdAt DateTime @default(now())

  @@unique([userId, key])
  @@index([deadline])
}

model UserSetting {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  key    String // مثلا "theme" | "removedOccurrences" | "customOccurrences"
  value  Json

  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId])
}

model ExportRequest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  format  String // pdf | csv
  module  ModuleKey?
  fileUrl String?
  status  String     @default("pending") // pending | ready | failed

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([userId])
}

model SharedProgressLink {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token     String     @unique // برای URL عمومی read-only
  module    ModuleKey?
  isActive  Boolean    @default(true)
  expiresAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
}

// ============================================================================
// OWNER PANEL — Audit Log / Error Log / Analytics Events / App Settings
// ============================================================================
// این بخش صرفا برای پنل Owner است. بدون رابطه‌ی مستقیم به User برای
// targetUserId (تا حذف یک کاربر لاگ اقدامات روش رو پاک نکنه — تاریخچه‌ی
// مدیریتی باید حتی بعد از حذف کاربر باقی بمونه)، پس فقط رشته‌ی id خام ذخیره
// می‌شه، نه FK.

// هر اقدام مدیریتی Owner روی داده‌ی واقعی — نه یک لاگ عمومی اپلیکیشن.
model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String // owner ای که اقدام رو انجام داده
  action      String // مثلا "user.block" | "user.plan_change" | "setting.ai_cost_rate"
  targetType  String? // مثلا "User" | "Subscription" | "AppSetting"
  targetId    String?
  meta        Json? // جزئیات قبل/بعد تغییر — هیچ‌وقت رمز/توکن/کلید داخلش ذخیره نشه
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId, createdAt])
}

// اطلاعیه‌ی سراسری اپ — از پنل ادمین (/admin/announcements) نوشته می‌شه و توی
// همون پنل زنگوله (NotificationPanel) به همه (حتی مهمان) نشون داده می‌شه.
// متن ساده‌ست (بدون HTML). «خوانده‌شده» سمت کاربر در تنظیم readAnnouncements
// نگه داشته می‌شه، نه جدول جدا — پس برای مهمان هم کار می‌کنه.
model Announcement {
  id          String    @id @default(cuid())
  title       String
  body        String
  active      Boolean   @default(true)
  // null یعنی بدون انقضا
  expiresAt   DateTime?
  createdById String? // ادمینی که ساخته (بدون FK — حذف ادمین اطلاعیه رو پاک نکنه)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([active, createdAt])
}

// رخدادهای خطای واقعی سیستم (نه Fake) — از جاهایی که واقعا catch می‌شن
// نوشته می‌شه: گیت‌وی AI، اتصال دیتابیس، و مسیرهای بحرانی auth.
model ErrorLog {
  id        String        @id @default(cuid())
  service   String // مثلا "ai-gateway" | "auth" | "database" | "payment"
  severity  ErrorSeverity @default(ERROR)
  message   String
  // هیچ‌وقت secret/token/password/apiKey داخل context ذخیره نشه — فقط
  // اطلاعات تشخیصی بی‌خطر (مثلا feature/model/statusCode)
  context   Json?
  createdAt DateTime      @default(now())

  @@index([createdAt])
  @@index([severity, createdAt])
}

// رویدادهای سبک برای تحلیل Funnel — فقط دو مرحله‌ای که جای دیگه‌ای قابل
// استخراج نیستن (بقیه‌ی مراحل Funnel از جداول موجود مثل User/Subscription/
// Payment مشتق می‌شن، نیازی به رویداد جداگانه ندارن)
model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String? // ممکنه مهمون باشه (هنوز ثبت‌نام نکرده)
  type      String // "view_subscription_page" | "checkout_start"
  meta      Json?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([userId, type])
}

// تنظیمات سراسری اپ (نه به‌ازای کاربر) — فقط برای مواردی که Owner باید
// بتونه بدون دیپلوی تغییرشون بده. الگوی key/value مثل UserSetting.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ── چت گروهی هر نماد ───────────────────────────────────────────────────
//
// یک اتاق عمومی به‌ازای هر نماد (EURUSD، XAUUSD، …) که همه‌ی کاربران
// دارای ماژول TRADE می‌بینند. عمدا «اتاق» یک جدول جدا نیست: اتاق‌ها از
// روی خود نماد ساخته می‌شوند و هیچ حالتی برای مدیریت ندارند، پس یک ستون
// نرمال‌شده کافی است و یک جدول خالی اضافه نمی‌خواهد.
//
// نکته‌ی مهم: پیام‌ها هیچ‌وقت واقعا حذف نمی‌شوند (`deletedAt`) — چون یک
// پیام گزارش‌شده باید بعد از حذف هم برای بررسی ادمین قابل خواندن بماند،
// وگرنه صف گزارش‌ها به ردیف‌های تهی تبدیل می‌شود.
model TradeChatMessage {
  id     String @id @default(cuid())
  symbol String // نماد اتاق، همیشه نرمال‌شده و بزرگ‌حرف: "EURUSD"

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  body String // متن خام؛ رندر سمت کلاینت همیشه متنی است، نه HTML

  // حذف نرم — توسط نویسنده یا ادمین. متن باقی می‌ماند ولی به کاربر
  // نشان داده نمی‌شود.
  deletedAt DateTime?
  deletedBy String? // شناسه‌ی کسی که حذف کرده (خود نویسنده یا ادمین)

  createdAt DateTime @default(now())

  reports TradeChatReport[]

  // کوئری اصلی صفحه: آخرین پیام‌های یک اتاق
  @@index([symbol, createdAt])
  @@index([userId])
}

enum TradeChatReportReason {
  SPAM // تبلیغ / اسپم
  ABUSE // توهین یا بی‌ادبی
  SCAM // کلاهبرداری یا سیگنال‌فروشی
  OFFTOPIC // بی‌ربط به این نماد
  OTHER
}

enum TradeChatReportStatus {
  OPEN // هنوز بررسی نشده
  ACTIONED // بررسی شد و پیام حذف شد
  DISMISSED // بررسی شد و مشکلی نداشت
}

model TradeChatReport {
  id String @id @default(cuid())

  messageId String
  message   TradeChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  reporterId String
  reporter   User   @relation("ChatReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  reason TradeChatReportReason
  note   String? // توضیح اختیاری گزارش‌دهنده

  status     TradeChatReportStatus @default(OPEN)
  reviewedAt DateTime?
  reviewedBy String?

  createdAt DateTime @default(now())

  // هر کاربر هر پیام را فقط یک بار می‌تواند گزارش کند — وگرنه یک نفر
  // می‌تواند با تکرار گزارش، صف را پر و اولویت را جعل کند.
  @@unique([messageId, reporterId])
  @@index([status, createdAt])
}

// ============================================================================
// MODULE: SUPPORT (تیکت‌های پشتیبانی — فقط توی سایت، بدون ایمیل/تلگرام)
// ============================================================================

enum SupportTicketStatus {
  OPEN // کاربر ثبت کرده، هنوز ادمین جواب نداده
  ANSWERED // ادمین جواب داده، منتظر کاربر یا بسته می‌مونه
  CLOSED // بسته‌شده (دستی ادمین یا خود کاربر)
}

model SupportTicket {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subject String
  status  SupportTicketStatus @default(OPEN)

  createdAt DateTime @default(now())
  // با هر پیام جدید (از کاربر یا ادمین) آپدیت می‌شه — لیست هر دو طرف بر
  // همین اساس مرتب می‌شه، نه createdAt، تا تیکت تازه‌جواب‌داده‌شده بیاد بالا.
  updatedAt DateTime @updatedAt

  messages SupportMessage[]

  @@index([userId, updatedAt])
  @@index([status, updatedAt])
}

model SupportMessage {
  id String @id @default(cuid())

  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // true یعنی این پیام از طرف ادمینه، نه خود صاحب تیکت — پیام ادمین
  // نویسنده‌ی جدا نداره (هر سوپریوزری می‌تونه جواب بده)، فقط پرچم همینه.
  fromAdmin Boolean @default(false)
  body      String

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

// ═════════════════════════════════════════════════════════════════════════
// اکوسیستم منتور ↔ شاگرد
//
// آریون خودش مربی‌گری نمی‌کنه؛ فقط ابزار ارتباط، ساخت/تایید/اجرای برنامه و
// پایش رو بین منتورهای مستقل و شاگردها فراهم می‌کنه. نکات طراحی:
//   - منتوربودن نقش جدا روی User نیست؛ داشتن MentorProfile یعنی منتور.
//     (پس سیستم کاربر/احراز هویت موازی ساخته نشده.)
//   - دسته‌های منتوری رشته‌ان، نه enum (lib/mentorCategories.ts رجیستری‌شونه)
//     تا اضافه‌شدن دسته‌ی جدید فقط تغییر کد/داده باشه، نه مایگریشن.
//   - هویت و مدرک تخصصی دو مفهوم جدان؛ مدرک به‌ازای هر دسته یک ردیف.
//   - حریم خصوصی به‌ازای هر رابطه (Mentorship) جداست — تغییر دسترسی منتور A
//     هیچ اثری روی منتور B نداره. اعمالش فقط سمت سرور (lib/mentorPrivacy.ts).
// ═════════════════════════════════════════════════════════════════════════

enum VerificationStatus {
  NOT_PROVIDED
  PENDING
  VERIFIED
  REJECTED
}

model MentorProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  headline    String?
  bio         String?
  specialties String[] @default([])
  // کلیدهای lib/mentorCategories.ts — مثلا ["FITNESS","NUTRITION"]
  categories  String[] @default([])
  // نقش منتور در حوزه‌ی روتین به زبان خودش (مثلا «استاد ریاضی») — فقط وقتی categories شامل ROUTINE باشه نمایش داده می‌شه
  routineRole String?

  // فقط وقتی true و موارد لازم پر باشه، توی کشف منتورها دیده می‌شه
  published         Boolean @default(false)
  acceptingStudents Boolean @default(true)

  // وضعیت احراز هویت — فقط ادمین تغییرش می‌ده (هیچ روت کاربری این فیلد رو نمی‌نویسه)
  identityStatus       VerificationStatus @default(NOT_PROVIDED)
  identityRejectReason String?
  identityReviewedAt   DateTime?

  // تعلیق منتوری توسط ادمین — از کشف حذف و ساخت برنامه/پذیرش شاگرد بسته می‌شه
  suspendedAt     DateTime?
  suspendedReason String?

  // خلاصه‌ی نظرات (فقط نظرات VISIBLE) — denormalized برای رتبه‌بندی/کشف
  ratingAvg   Float @default(0)
  ratingCount Int   @default(0)

  lastActiveAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  credentials        MentorCredential[]
  documents          MentorDocument[]
  verificationEvents MentorVerificationEvent[]

  // ── دسترس‌پذیری و مدیریت شاگرد (مهاجرت 20260927161000_mentor_availability) ──
  // هر گزینه مستقل است و با حذف ستون‌های همین بلوک برداشته می‌شود.
  // سقف شاگرد فعال؛ null = بدون سقف. پر بودن فقط درخواست شاگرد را می‌بندد، نه دعوت خود منتور
  maxActiveStudents  Int?
  // حالت «در دسترس نیستم تا …» — تاریخ بازگشت (روز)؛ بعد از این روز خودبه‌خود بی‌اثر می‌شود
  awayUntil          DateTime?            @db.Date
  awayMessage        String?
  // در مدت عدم حضور، درخواست شاگرد جدید پذیرفته نشود
  awayPausesRequests Boolean              @default(true)
  // انتظار زمان پاسخ (ساعت) که روی پروفایل نمایش داده می‌شود
  responseTimeHours  Int?
  // پیامی که با پذیرش رابطه خودکار در گفت‌وگو فرستاده می‌شود
  welcomeMessage     String?
  // سؤال‌های پذیرش (حداکثر ۵) که شاگرد هنگام درخواست جواب می‌دهد
  intakeQuestions    String[]             @default([])
  studentLabels      MentorStudentLabel[]

  // ── ابزارهای برنامه و گزارش (مهاجرت 20260927162000_mentor_tools) ──
  // هر گزینه مستقل است و با حذف همین بلوک و مدل‌هایش برداشته می‌شود.
  // هشدار پایبندی: وقتی شاگرد n روز برنامه‌دار پشت‌سرهم هیچ آیتمی انجام نداد؛ null = خاموش
  alertMissedDays  Int?
  programTemplates MentorProgramTemplate[]
  savedReplies     MentorSavedReply[]

  // ── رتبه‌بندی شایستگی (مهاجرت 20260927164000_mentor_ranking) — lib/mentorRankingStats.ts ──
  rankingStats MentorRankingStat[]

  // ── پذیرش شرایط منتوری (مهاجرت 20260928104000_mentor_terms_acceptance) — lib/mentorTerms.ts ──
  // بدون پذیرش نسخه‌ی جاری، PUT /api/mentors/me پروفایل نمی‌سازد/ذخیره نمی‌کند
  acceptedMentorTermsAt DateTime?
  mentorTermsVersion    String?

  // ── صف انتظار (مهاجرت 20260928140000_mentor_waitlist) — lib/mentorWaitlistServer.ts ──
  // فقط شمارنده‌ی قفل: پیش‌بردن صف با update همین ردیف قفل ردیفی می‌گیرد تا دو
  // درخواست هم‌زمان یک صندلی خالی را به دو نفر پیشنهاد ندهند (بدون raw SQL).
  waitlistSeq Int @default(0)

  @@index([published, suspendedAt])
}

// امتیاز شایستگی denormalized هر منتور، یک ردیف به‌ازای هر دامنه: "ALL" (کلی)
// و هر دسته‌ی منتور (FITNESS/ROUTINE/…، فقط از سیگنال‌های همون حوزه). خود روت
// خواندن با ensureFreshRankings کهنه‌اش رو تازه می‌کنه (بدون cron). فرمول و
// دلیل هر وزن: docs/mentor-ranking.md. کل جدول از روی داده‌ی خام قابل بازسازیه.
model MentorRankingStat {
  id              String        @id @default(cuid())
  profileId       String
  profile         MentorProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  category        String // "ALL" | کلید lib/mentorCategories.ts
  // امتیاز شایستگی ۰..۱۰۰ — ترتیب «بهترین نتیجه»
  score           Float         @default(0)
  // امتیاز نظرهای تاییدشده (بیزی، ۰..۱) — ترتیب «بالاترین امتیاز»
  ratingScore     Float         @default(0)
  // حداقل نمونه و اعتماد برای ورود به «منتورهای محبوب»
  eligible        Boolean       @default(false)
  // شاگردهای معتبر شمرده‌شده و نظرهای تاییدشده — tie-break و نمایش ادمین
  sampleStudents  Int           @default(0)
  verifiedReviews Int           @default(0)
  // جزئیات هر مؤلفه برای توضیح ادمین (lib/mentorRanking.ts → MeritBreakdown)
  breakdown       Json
  computedAt      DateTime      @default(now())

  @@unique([profileId, category])
  @@index([category, score(sort: Desc)])
  @@index([category, ratingScore(sort: Desc)])
  @@index([computedAt])
}

// مدرک تخصصی یک دسته (مثلا FITNESS) — وضعیتش مستقل از هویت و از دسته‌های دیگه
model MentorCredential {
  id           String             @id @default(cuid())
  profileId    String
  profile      MentorProfile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  category     String
  status       VerificationStatus @default(NOT_PROVIDED)
  rejectReason String?
  reviewedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([profileId, category])
  @@index([status])
}

enum MentorDocumentKind {
  IDENTITY
  CERTIFICATE
}

// مدارک حساس (کارت ملی/مدرک). عمدا *داخل دیتابیس* نگه داشته می‌شن نه
// public/ — استوریج ابری نداریم و هر فایلی در public/ مستقیم قابل‌دانلوده.
// فقط از روت ادمین با requireAdmin("mentors") و خود صاحبش سرو می‌شن؛
// هیچ مسیر فایلی به کلاینت برنمی‌گرده.
model MentorDocument {
  id        String             @id @default(cuid())
  profileId String
  profile   MentorProfile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  kind      MentorDocumentKind
  category  String? // فقط برای CERTIFICATE
  fileName  String // نام پاک‌سازی‌شده، فقط برای نمایش
  mimeType  String // از روی magic bytes تشخیص داده می‌شه، نه هدر کلاینت
  sizeBytes Int
  sha256    String
  data      Bytes
  createdAt DateTime           @default(now())

  @@index([profileId, kind])
}

// تاریخچه‌ی تصمیم‌های احراز — هر تغییر وضعیت (ارسال، تایید، رد) یک ردیف
model MentorVerificationEvent {
  id          String             @id @default(cuid())
  profileId   String
  profile     MentorProfile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  kind        MentorDocumentKind
  category    String?
  fromStatus  VerificationStatus
  toStatus    VerificationStatus
  reason      String?
  actorUserId String
  createdAt   DateTime           @default(now())

  @@index([profileId, createdAt])
}

enum MentorshipStatus {
  PENDING
  ACTIVE
  REJECTED
  BLOCKED
  ENDED
}

// رابطه‌ی منتور ↔ شاگرد — یک ردیف به‌ازای هر جفت (unique)، پس رابطه‌ی
// تکراری ممکن نیست؛ درخواست دوباره بعد از رد/پایان همین ردیف رو PENDING می‌کنه.
model Mentorship {
  id          String           @id @default(cuid())
  mentorId    String
  mentor      User             @relation("MentorshipMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  studentId   String
  student     User             @relation("MentorshipStudent", fields: [studentId], references: [id], onDelete: Cascade)
  status      MentorshipStatus @default(PENDING)
  initiatedBy String // "STUDENT" | "MENTOR" — فقط طرف مقابل می‌تونه قبول کنه
  // حوزه‌هایی که این رابطه پوشش می‌ده (زیرمجموعه‌ی دسته‌های منتور، مثلا ["ROUTINE"]).
  // منتورهای شاگرد با همین از هم تفکیک می‌شن و نوع برنامه‌ی مجاز هم از همین میاد.
  // خالی = رابطه‌ی قدیمی قبل از این فیلد → همه‌ی حوزه‌های منتور.
  categories  String[]         @default([])
  message     String?
  blockedById String?

  // ── حریم خصوصی این رابطه (فقط شاگرد تغییرش می‌ده) ──
  // کدوم برنامه‌های خود شاگرد برای این منتور دیده بشه (کلیدهای lib/mentorPrivacy.ts)
  shareAllPrograms Boolean  @default(false)
  sharedPrograms   String[] @default([])
  // چه سطحی از جزئیات
  showSchedule     Boolean  @default(true)
  showProgramName  Boolean  @default(true)
  showTaskName     Boolean  @default(false)
  showTaskDetails  Boolean  @default(false)
  showProgress     Boolean  @default(true)

  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  programs MentorProgram[]
  messages MentorMessage[]
  reviews  MentorReview[]

  // ── مدیریت شاگرد از سمت منتور (مهاجرت 20260927161000_mentor_availability) ──
  // پاسخ شاگرد به سؤال‌های پذیرش — هر جواب یک ردیف (MentorIntakeAnswer)
  intakeAnswers        MentorIntakeAnswer[]
  // توقف موقت رابطه توسط منتور (وضعیت ACTIVE می‌ماند)
  pausedAt             DateTime?
  pauseReason          String?
  // دلیل پایان و این‌که کدام طرف پایان داد ("MENTOR" | "STUDENT")
  endReason            String?
  endedBy              String?
  // برچسب‌های خصوصی منتور روی این شاگرد (idهای MentorStudentLabel)
  mentorLabelIds       String[]               @default([])
  mentorNotes          MentorStudentNote[]
  // هشدارهای پایبندی ثبت‌شده (مهاجرت 20260927162000_mentor_tools)
  adherenceAlerts      MentorAdherenceAlert[]
  // نسخه‌ی «شرایط منتورها» که شاگرد هنگام درخواست همین رابطه پذیرفته بود (مهاجرت 20260928104000_mentor_terms_acceptance)
  studentTermsVersion  String?
  // «پاک کردن سابقه‌ی گفت‌وگو» فقط برای خود هر طرف (مهاجرت 20260928101000_mentor_chat_history):
  // پیام‌های تا این لحظه برای همان طرف دیگر برگردانده نمی‌شوند؛ نسخه‌ی طرف مقابل دست نمی‌خورد.
  mentorClearedBefore  DateTime?
  studentClearedBefore DateTime?
  // درخواستی که از پذیرش نوبت صف ساخته شد (مهاجرت 20260928140000_mentor_waitlist)
  waitlistEntries      MentorWaitlistEntry[]

  @@unique([mentorId, studentId])
  @@index([studentId, status])
  @@index([mentorId, status])
}

// ── صف انتظار برای منتور پر (مهاجرت 20260928140000_mentor_waitlist) ──
// وقتی ظرفیت شاگرد فعال منتور پر است، کاربر به‌جای ردشدن وارد صف می‌شود.
// با خالی‌شدن صندلی، نفر اول WAITING نوبت (OFFERED) می‌گیرد و تا offerExpiresAt
// فرصت دارد درخواست عادی (با همان سؤال‌های پذیرش) بفرستد → ACCEPTED + mentorshipId.
// نوبت زنده و درخواست PENDING ساخته‌شده از صف، صندلی را برای همان نفر نگه می‌دارند.
// هیچ متن آزادی این‌جا ذخیره نمی‌شود؛ رتبه‌بندی این جدول را نمی‌خواند.
enum MentorWaitlistStatus {
  WAITING
  OFFERED
  ACCEPTED
  EXPIRED
  CANCELLED
}

model MentorWaitlistEntry {
  id             String               @id @default(cuid())
  mentorId       String
  mentor         User                 @relation("MentorWaitlistMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  userId         String
  user           User                 @relation("MentorWaitlistStudent", fields: [userId], references: [id], onDelete: Cascade)
  status         MentorWaitlistStatus @default(WAITING)
  // ترتیب صف (FIFO) — با ورود دوباره بعد از خروج/انقضا از نو تنظیم می‌شود
  joinedAt       DateTime             @default(now())
  offeredAt      DateTime?
  offerExpiresAt DateTime?
  acceptedAt     DateTime?
  // "USER" | "MENTOR" | "SYSTEM" — چه کسی/چه چیزی نوبت را بست (CANCELLED/EXPIRED)
  closedBy       String?
  closedAt       DateTime?
  mentorshipId   String?
  mentorship     Mentorship?          @relation(fields: [mentorshipId], references: [id], onDelete: SetNull)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([mentorId, userId])
  @@index([mentorId, status, joinedAt])
  @@index([status, offerExpiresAt])
  @@index([userId, status])
}

// برچسب خصوصی منتور برای دسته‌بندی شاگردها (مثلا «کنکور ۱۴۰۶») — فقط خود منتور می‌بیند
model MentorStudentLabel {
  id        String        @id @default(cuid())
  profileId String
  profile   MentorProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime      @default(now())

  @@unique([profileId, name])
}

// یادداشت خصوصی منتور درباره‌ی یک شاگرد — هرگز به شاگرد نشان داده نمی‌شود
model MentorStudentNote {
  id           String     @id @default(cuid())
  mentorshipId String
  mentorship   Mentorship @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)
  mentorId     String
  body         String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([mentorshipId, createdAt])
}

// جواب شاگرد به یک سؤال پذیرش — snapshot متن سؤال در لحظه‌ی درخواست تا
// ویرایش بعدی سؤال‌ها جواب قبلی را بی‌معنا نکند. با درخواست دوباره جایگزین می‌شود.
model MentorIntakeAnswer {
  id           String     @id @default(cuid())
  mentorshipId String
  mentorship   Mentorship @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)
  order        Int
  question     String
  answer       String
  createdAt    DateTime   @default(now())

  @@unique([mentorshipId, order])
}

// ── ابزارهای منتور (مهاجرت 20260927162000_mentor_tools) ──

// قالب برنامه: کپی محتوای یک برنامه (بدون شاگرد و تاریخ) برای استفاده‌ی دوباره.
// آیتم‌ها JSON‌اند (همان شکل ItemData در lib/mentorValidate.ts) و هنگام ساخت
// برنامه از قالب دوباره با validateProgramInput اعتبارسنجی می‌شوند.
model MentorProgramTemplate {
  id           String            @id @default(cuid())
  profileId    String
  profile      MentorProfile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name         String
  type         MentorProgramType
  title        String
  description  String?
  note         String?
  // طول بازه‌ی برنامه‌ی مبدا به روز (پایان − شروع)؛ با انتخاب تاریخ شروع، پایان از همین حساب می‌شود
  durationDays Int?
  items        Json
  itemCount    Int               @default(0)
  usedCount    Int               @default(0)
  lastUsedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([profileId, updatedAt])
}

// پاسخ آماده‌ی منتور برای گفت‌وگو — فقط متن؛ درج در گفت‌وگو سمت کلاینت انجام می‌شود
model MentorSavedReply {
  id        String        @id @default(cuid())
  profileId String
  profile   MentorProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title     String
  body      String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([profileId, createdAt])
}

// هشدار پایبندی ثبت‌شده — یکتا به‌ازای رابطه و روز تا اعلان تکراری ساخته نشود
model MentorAdherenceAlert {
  id           String     @id @default(cuid())
  mentorshipId String
  mentorship   Mentorship @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)
  day          DateTime   @db.Date
  missedDays   Int
  createdAt    DateTime   @default(now())

  @@unique([mentorshipId, day])
}

enum MentorProgramStatus {
  DRAFT
  PENDING
  ACCEPTED
  REJECTED
  ACTIVE
  COMPLETED
  CANCELLED
}

// نوع برنامه — enum که اضافه‌کردن نوع جدید (مثلا تغذیه) فقط یک مقدار اضافه کنه
enum MentorProgramType {
  ROUTINE
  WORKOUT
}

model MentorProgram {
  id                String              @id @default(cuid())
  mentorshipId      String
  mentorship        Mentorship          @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)
  mentorId          String
  mentor            User                @relation("MentorProgramMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  studentId         String
  student           User                @relation("MentorProgramStudent", fields: [studentId], references: [id], onDelete: Cascade)
  type              MentorProgramType
  title             String
  description       String?
  // یادداشت منتور برای شاگرد روی این برنامه (جدا از توضیح برنامه)
  note              String?
  startDate         DateTime?           @db.Date
  endDate           DateTime?           @db.Date
  status            MentorProgramStatus @default(DRAFT)
  // هر ارسال دوباره بعد از «درخواست تغییر» نسخه رو یکی بالا می‌بره
  version           Int                 @default(1)
  changeRequestNote String?
  rejectReason      String?

  sentAt      DateTime?
  respondedAt DateTime?
  activatedAt DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items    MentorProgramItem[]
  logs     MentorProgramLog[]
  feedback MentorFeedback[]

  // ── پیشرفت خودکار (مهاجرت 20260927160000_mentor_auto_progress) ──
  // آخرین همگام‌سازی لاگ‌های AUTO از تیک‌های روتین شاگرد (lib/mentorProgress.ts).
  // null روی برنامه‌ی بسته = برنامه‌ی قدیمی قبل از پیشرفت خودکار؛ دیگر همگام نمی‌شود.
  progressSyncedAt DateTime?
  dayNotes         MentorProgramDayNote[]

  @@index([studentId, status])
  @@index([mentorId, status])
  @@index([mentorshipId])
}

// یک آیتم برنامه — برای ROUTINE تسک زمان‌دار، برای WORKOUT یک حرکت
model MentorProgramItem {
  id          String        @id @default(cuid())
  programId   String
  program     MentorProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  order       Int           @default(0)
  title       String
  details     String?
  // زمان‌بندی: روزهای هفته به jsDay (۰=یکشنبه) — DAILY یعنی همه‌ی روزها
  repeat      String        @default("WEEKLY") // "DAILY" | "WEEKLY"
  days        Int[]         @default([])
  startTime   String? // "HH:mm"
  durationMin Int?
  // فقط WORKOUT
  sets        Int?
  reps        String? // "8-12" یا "10"
  weightKg    Float?
  restSec     Int?

  logs     MentorProgramLog[]
  feedback MentorFeedback[]

  @@index([programId, order])
}

enum ProgramLogStatus {
  COMPLETED
  PARTIAL
  MISSED
}

// اجرای یک آیتم در یک روز — یک ردیف به‌ازای هر آیتم/روز
model MentorProgramLog {
  id        String            @id @default(cuid())
  programId String
  program   MentorProgram     @relation(fields: [programId], references: [id], onDelete: Cascade)
  itemId    String
  item      MentorProgramItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  studentId String
  date      DateTime          @db.Date
  status    ProgramLogStatus
  setsDone  Int?
  note      String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  // ── پیشرفت خودکار (مهاجرت 20260927160000_mentor_auto_progress) ──
  // "AUTO" = برگرفته از تیک‌های روتین شاگرد (فقط همگام‌سازی می‌نویسد/پاک می‌کند)؛
  // "MANUAL" = ثبت دستی قدیمی، دست‌نخورده می‌ماند.
  source String    @default("MANUAL")
  // روزی که واقعا تیک خورد، وقتی شاگرد آیتم را در همان هفته به روز دیگری برده بود
  doneOn DateTime? @db.Date

  feedback MentorFeedback[]

  @@unique([itemId, date])
  @@index([programId, date])
  @@index([studentId, date])
}

// یادداشت اختیاری شاگرد برای منتور روی یک روز برنامه — فقط توضیح، هرگز وضعیت
// (مهاجرت 20260927160000_mentor_auto_progress)
model MentorProgramDayNote {
  id        String        @id @default(cuid())
  programId String
  program   MentorProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  studentId String
  date      DateTime      @db.Date
  body      String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([programId, date])
}

model MentorFeedback {
  id        String             @id @default(cuid())
  programId String
  program   MentorProgram      @relation(fields: [programId], references: [id], onDelete: Cascade)
  itemId    String?
  item      MentorProgramItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  logId     String?
  log       MentorProgramLog?  @relation(fields: [logId], references: [id], onDelete: SetNull)
  mentorId  String
  studentId String
  body      String
  readAt    DateTime?
  createdAt DateTime           @default(now())

  @@index([programId, createdAt])
  @@index([studentId, readAt])
}

model MentorMessage {
  id           String     @id @default(cuid())
  mentorshipId String
  mentorship   Mentorship @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)
  senderId     String
  sender       User       @relation(fields: [senderId], references: [id], onDelete: Cascade)
  readAt       DateTime?
  createdAt    DateTime   @default(now())

  // ── رمزگذاری سرتاسری (مهاجرت 20260927163000_mentor_e2ee؛ docs/mentor-e2ee.md) ──
  // سرور فقط متن رمزشده می‌بیند. دقیقا یکی از legacyBody / ciphertext پر است (CHECK در SQL).
  // متن ساده پیام‌های پیش از رمزگذاری — فقط برای دو طرف؛ با بازرمزگذاری در کلاینت یا ۳۰ روز بعد پاک می‌شود
  legacyBody          String?
  // شناسه‌ی تصادفی کلاینت (بخشی از AAD)؛ یکتا در هر گفت‌وگو → ضد replay
  clientId            String?
  ciphertext          String?
  iv                  String?
  senderKeyVersion    Int?
  recipientKeyVersion Int?
  // تعهد فرانکینگ = HMAC(fk, زمینه‖متن)؛ serverTag = HMAC(راز سرور، تعهد+فرستنده+زمان)
  commitment          String?
  serverTag           String?
  // پیام‌هایی که با «ارسال گروهی» ساخته شده‌اند یک شناسه‌ی مشترک دارند
  broadcastId         String?
  // ── چنددستگاهی (مهاجرت 20260928102000_e2ee_auto) ──
  // scheme 1 = کلید جفتی (نسخه‌ی منتور، نسخه‌ی شاگرد)؛ scheme 2 = کلید محتوای تصادفی که
  // برای *هر* کلید فعال دو طرف جدا بسته‌بندی شده (MentorMessageKeyWrap). در scheme 2
  // senderKeyVersion = کلیدی که بسته‌بندی‌ها را ساخته و keyFromId صاحب آن کلید است اگر
  // با فرستنده فرق کند (بازرمزگذاری پیام قدیمی توسط طرف مقابل).
  scheme              Int                    @default(1)
  keyFromId           String?
  wraps               MentorMessageKeyWrap[]

  @@unique([mentorshipId, clientId])
  @@index([mentorshipId, createdAt])
  @@index([mentorshipId, senderId, readAt])
}

// کلید هویت رمزگذاری سرتاسری (ECDH P-256) — مهاجرت 20260927163000_mentor_e2ee.
// کلید خصوصی هرگز به سرور نمی‌رسد؛ فقط «پشتیبان رمزشده» با کلیدی که از رمز
// گفت‌وگوی کاربر (PBKDF2) ساخته می‌شود. سرور و Owner نمی‌توانند بازش کنند.
model UserE2EKey {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  version          Int
  // نقطه‌ی فشرده‌نشده‌ی P-256 (۶۵ بایت) به base64
  publicKey        String
  // پشتیبان رمزشده‌ی کلید خصوصی (PKCS8 ⟵ AES-256-GCM ⟵ PBKDF2-SHA256(رمز گفت‌وگو))
  backupCiphertext String?
  backupIv         String?
  backupSalt       String?
  backupIterations Int?
  // null = کلید جاری. با «بازنشانی» مقدار می‌گیرد و پشتیبانش پاک می‌شود؛ کلید
  // عمومی می‌ماند تا طرف مقابل پیام‌های قدیمی‌اش را هنوز بخواند.
  retiredAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // ── رمزگذاری خودکار (مهاجرت 20260928102000_e2ee_auto؛ docs/mentor-e2ee.md) ──
  // SYNCED = یک کلید برای همه‌ی دستگاه‌ها، پشتیبانش با کلید مشتق از رمز عبور (یا رمز
  // گفت‌وگوی قدیمی) قفل است؛ DEVICE = کلید یک دستگاه که هرگز از آن بیرون نمی‌رود.
  kind            E2EKeyKind @default(SYNCED)
  // "PASSWORD" | "PASSCODE" (قدیمی، یک بار با رمز گفت‌وگو باز و به PASSWORD منتقل می‌شود)
  backupKind      String?
  // = userId فقط برای کلید SYNCED فعال → یکتایی: هر کاربر حداکثر یک کلید SYNCED فعال
  activeSyncedFor String?    @unique
  deviceLabel     String?
  lastSeenAt      DateTime?

  @@unique([userId, version])
  @@index([userId, retiredAt])
}

enum E2EKeyKind {
  SYNCED
  DEVICE
}

// نمک کلید بسته‌بندی مشتق از رمز عبور (PBKDF2). سرور خود کلید را هرگز نمی‌بیند.
model UserE2EKdf {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  salt       String
  iterations Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// کلید محتوای یک پیام scheme 2، بسته‌بندی‌شده برای یک کلید مشخص یکی از دو طرف.
// viaVersion پر = انتقال سابقه: این بسته‌بندی را دستگاه دیگر *همین* کاربر با کلید
// viaVersion خودش ساخته (نه فرستنده).
model MentorMessageKeyWrap {
  id         String        @id @default(cuid())
  messageId  String
  message    MentorMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId     String
  keyVersion Int
  wrap       String
  viaVersion Int?
  createdAt  DateTime      @default(now())

  @@unique([messageId, userId, keyVersion])
  @@index([userId, keyVersion])
}

// «انتقال سابقه از دستگاه دیگر»: دستگاه تازه درخواست می‌دهد، دستگاه قدیمی پس از
// تطبیق کد کوتاه تایید می‌کند و کلیدهای محتوا را برای کلید دستگاه تازه بسته‌بندی می‌کند.
model E2EDeviceLink {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetVersion Int
  // PENDING | DONE | DECLINED
  status        String    @default("PENDING")
  moved         Int       @default(0)
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  completedAt   DateTime?

  @@index([userId, status])
}

enum MentorReviewStatus {
  VISIBLE
  HIDDEN
}

// فقط شاگردی که رابطه‌ی واقعی (ACTIVE یا ENDED بعد از فعال‌شدن) داشته؛ یکی به‌ازای هر جفت
model MentorReview {
  id           String             @id @default(cuid())
  mentorId     String
  mentor       User               @relation("MentorReviewMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  studentId    String
  student      User               @relation("MentorReviewStudent", fields: [studentId], references: [id], onDelete: Cascade)
  mentorshipId String
  mentorship   Mentorship         @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)
  rating       Int // ۱ تا ۵
  body         String?
  status       MentorReviewStatus @default(VISIBLE)
  hiddenReason String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([mentorId, studentId])
  @@index([mentorId, status, createdAt])
}

enum MentorReportTarget {
  USER
  REVIEW
  MESSAGE
  PROGRAM
  // گزارش کل گفت‌وگو (targetId = mentorshipId)؛ پیام‌های پیوست در MentorReportMessage
  CONVERSATION
}

enum MentorReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model MentorReport {
  id           String             @id @default(cuid())
  reporterId   String
  reporter     User               @relation("MentorReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType   MentorReportTarget
  targetId     String
  // صاحب محتوای گزارش‌شده — برای اقدام ادمین (تعلیق/مسدودی)
  targetUserId String?
  reason       String
  details      String?
  status       MentorReportStatus @default(OPEN)
  resolution   String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime           @default(now())

  // ── گزارش پیام رمزشده (مهاجرت 20260927163000_mentor_e2ee) ──
  // متن *همان یک* پیام گزارش‌شده، فقط پس از تایید تعهد فرانکینگ؛ رمزشده
  // در حال سکون (MENTOR_DATA_KEY). ادمین جز همین متن هیچ پیامی را نمی‌بیند.
  reportedText      String?
  reportedMessageAt DateTime?
  // true = متن با تعهد رمزنگاری فرستنده تایید شد؛ false = پیام قدیمی پیش از رمزگذاری
  reportVerified    Boolean               @default(false)
  // پیام‌های پیوست گزارش گفت‌وگو (مهاجرت 20260928101000_mentor_chat_history)
  messages          MentorReportMessage[]

  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
}

// اعلان درون‌برنامه‌ای (زنگوله) — پایدار روی سرور، برخلاف NotificationPanel
// قبلی که همه‌چیز رو سمت کلاینت حساب می‌کرد. پوش هم best-effort کنارش می‌ره.
model InAppNotification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // مثلا "mentor.request" | "program.new" | "message.new"
  title     String
  body      String
  url       String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// منتور ذخیره‌شده (نشانک) — کاربر حداکثر ۱۰ منتور را برای تصمیم بعدی نگه می‌دارد.
// سقف سمت سرور اعمال می‌شود (lib/savedMentors.ts). مهاجرت 20260928100000_saved_mentors
model SavedMentor {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation("SavedMentorOwner", fields: [userId], references: [id], onDelete: Cascade)
  mentorUserId String
  mentor       User     @relation("SavedMentorTarget", fields: [mentorUserId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([userId, mentorUserId])
  @@index([userId, createdAt])
  @@index([mentorUserId])
}

// یک پیام پیوست «گزارش گفت‌وگو» (مهاجرت 20260928101000_mentor_chat_history).
// هر پیام جداگانه با همان فرانکینگ گزارش تکی تایید می‌شود؛ متن فقط همین‌جا و
// رمزشده در حال سکون (MENTOR_DATA_KEY) نگه داشته می‌شود — ادمین هیچ پیام دیگری را نمی‌بیند.
model MentorReportMessage {
  id        String       @id @default(cuid())
  reportId  String
  report    MentorReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  messageId String
  senderId  String
  text      String
  messageAt DateTime
  // true = تعهد فرانکینگ تایید شد؛ false = پیام قدیمی پیش از رمزگذاری
  verified  Boolean      @default(false)
  position  Int

  @@unique([reportId, messageId])
  @@index([reportId, position])
}
